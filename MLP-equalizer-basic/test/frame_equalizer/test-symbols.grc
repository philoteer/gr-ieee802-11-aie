- name: verify
  id: snippet
  parameters:
    alias: ''
    code: "import numpy as np\nimport pmt\n\nexpected = np.asarray(self.payload_data,\
      \ dtype=np.uint8).reshape(-1, 48)\ngnu_hard = np.asarray(self.blocks_gnu_decisions_sink.data(),\
      \ dtype=np.int8).reshape(-1, 48)\nnpu_hard = np.asarray(self.blocks_npu_decisions_sink.data(),\
      \ dtype=np.int8).reshape(-1, 48)\nif gnu_hard.shape != (17, 48) or npu_hard.shape\
      \ != (17, 48):\n    raise AssertionError(\n        f'decoded symbol count mismatch:\
      \ GNU={gnu_hard.shape}, '\n        f'NPU={npu_hard.shape}, expected=(17, 48)')\n\
      \nmarker = {}\nwith open('build/frame_equalizer_build_mode.txt') as stream:\n\
      \    for line in stream:\n        if '=' in line:\n            key, value =\
      \ line.split('=', 1)\n            marker[key.strip()] = value.strip()\nif marker.get('ENGINE')\
      \ == 'AI':\n    np.testing.assert_array_equal(npu_hard, expected)\nelse:\n \
      \   np.testing.assert_array_equal(npu_hard[:16], gnu_hard[:16])\n    np.testing.assert_array_equal(npu_hard[16],\
      \ expected[16])\n\ncsi = {}\nencodings = {}\nfor tag in self.blocks_npu_decisions_sink.tags():\n\
      \    offset = int(tag.offset)\n    key = pmt.symbol_to_string(tag.key)\n   \
      \ if key == 'csi':\n        if offset in csi:\n            raise AssertionError(f'duplicate\
      \ csi tag at symbol {offset}')\n        values = np.asarray(pmt.c32vector_elements(tag.value),\
      \ dtype=np.complex64)\n        if values.size < 48:\n            raise AssertionError(\n\
      \                f'csi tag at symbol {offset} has {values.size} values; expected\
      \ at least 48')\n        csi[offset] = values[:48]\n    elif key == 'encoding':\n\
      \        if offset in encodings:\n            raise AssertionError(f'duplicate\
      \ encoding tag at symbol {offset}')\n        encodings[offset] = int(pmt.to_uint64(tag.value))\n\
      if sorted(csi) != list(range(17)) or sorted(encodings) != list(range(17)):\n\
      \    raise AssertionError(\n        f'symbol tag coverage mismatch: csi={sorted(csi)},\
      \ encodings={sorted(encodings)}')\nactual_encodings = [encodings[i] for i in\
      \ range(17)]\nwanted_encodings = list(range(8)) + [5] * 8 + [0]\nif actual_encodings\
      \ != wanted_encodings:\n    raise AssertionError(f'encoding tags {actual_encodings!r}\
      \ != {wanted_encodings!r}')\n\ndebug = self.blocks_symbols_debug\nif debug.num_messages()\
      \ != 17:\n    raise AssertionError(\n        f'GNU Radio emitted {debug.num_messages()}\
      \ symbol PDUs; expected 17')\ngnu_symbols = np.asarray([\n    np.asarray(pmt.c32vector_elements(pmt.cdr(debug.get_message(i))),\
      \ dtype=np.complex64)\n    for i in range(17)])\nif gnu_symbols.shape != (17,\
      \ 48):\n    raise AssertionError(f'GNU Radio symbol PDU shape mismatch: {gnu_symbols.shape}')\n\
      npu_symbols = np.asarray([csi[i] for i in range(17)])\n\ndef check_error(label,\
      \ actual, reference, limit):\n    error = actual - reference\n    evm = np.sqrt(np.mean(abs(error)\
      \ ** 2) / np.mean(abs(reference) ** 2))\n    gain = np.vdot(reference.ravel(),\
      \ actual.ravel()) / np.vdot(\n        reference.ravel(), reference.ravel())\n\
      \    print(f'{label}: rms_evm={100 * evm:.5f}% max_abs={np.max(abs(error)):.7f}\
      \ '\n          f'gain={abs(gain):.8f} phase={np.angle(gain):.8g} rad')\n   \
      \ if not evm < limit:\n        raise AssertionError(f'{label}: EVM {evm} is\
      \ not below {limit}')\n\ncheck_error('all rates, flat channel', npu_symbols[:8],\
      \ gnu_symbols[:8], 5e-4)\ncheck_error('frequency-selective tracked frame',\n\
      \            npu_symbols[8:16], gnu_symbols[8:16], 2e-3)\nprint(f'frame_equalizer\
      \ {self.algorithm} GRC symbol comparison passed')"
    comment: Compare decisions, tags, and symbol EVM; runs after the flowgraph stops.
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 1256.0]
    rotation: 0
    state: enabled
