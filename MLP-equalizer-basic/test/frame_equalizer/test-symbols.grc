- name: zz_build_guard_and_impairment
  id: epy_block
  parameters:
    _source_code: "from pathlib import Path\n\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\ndef _require_build(algorithm):\n    supported = {'ls', 'lms', 'comb',\
      \ 'sta'}\n    if algorithm not in supported:\n        raise RuntimeError(\n\
      \            f\"unknown EQUALIZER_ALGORITHM={algorithm!r}; choose LS, LMS, COMB,\
      \ or STA\")\n    build = Path('build')\n    marker = build / 'frame_equalizer_build_mode.txt'\n\
      \    artifacts = [build / 'final.xclbin', build / 'insts.bin']\n    missing\
      \ = [str(path) for path in [marker, *artifacts] if not path.is_file()]\n   \
      \ if missing:\n        raise RuntimeError(\n            'missing frame-equalizer\
      \ build output(s): ' + ', '.join(missing) +\n            '; run `make test-grc\
      \ EQUALIZER_ALGORITHM=' + algorithm.upper() + '`')\n    mode = {}\n    for line\
      \ in marker.read_text().splitlines():\n        if '=' in line:\n           \
      \ key, value = line.split('=', 1)\n            mode[key.strip()] = value.strip()\n\
      \    if mode.get('DFRAME_EQUALIZER_OUTPUT_SYMBOLS') != '1':\n        raise RuntimeError(\n\
      \            'NPU is not a symbols build (DFRAME_EQUALIZER_OUTPUT_SYMBOLS='\
      \ +\n            repr(mode.get('DFRAME_EQUALIZER_OUTPUT_SYMBOLS')) +\n     \
      \       '); run `make test-grc EQUALIZER_ALGORITHM=' + algorithm.upper() + '`')\n\
      \    if mode.get('EQUALIZER_ALGORITHM', '').lower() != algorithm:\n        raise\
      \ RuntimeError(\n            'NPU algorithm is ' + repr(mode.get('EQUALIZER_ALGORITHM',\
      \ 'unknown')) +\n            ', but the flowgraph selected ' + repr(algorithm)\
      \ +\n            '; rebuild through `make test-grc EQUALIZER_ALGORITHM=' +\n\
      \            algorithm.upper() + '`')\n    if mode.get('ENGINE') not in {'CLASSIC',\
      \ 'AI'}:\n        raise RuntimeError('invalid or missing ENGINE in ' + str(marker))\n\
      \    if marker.stat().st_mtime_ns < max(path.stat().st_mtime_ns for path in\
      \ artifacts):\n        raise RuntimeError(\n            str(marker) + ' is older\
      \ than the NPU artifacts; rebuild with `make test-grc`')\n    instructions =\
      \ np.fromfile(artifacts[1], dtype=np.uint32)\n    for sentinel in (0x13579BDF,\
      \ 0x2468ACE0):\n        count = int(np.count_nonzero(instructions == sentinel))\n\
      \        if count != 1:\n            raise RuntimeError(\n                f'build/insts.bin\
      \ has {count} copies of RTP marker {sentinel:#x}; expected 1')\n\n\ndef _profiles():\n\
      \    flat = np.full((32, 64), 0.5, dtype=np.complex64)\n    channel = np.zeros(64,\
      \ dtype=np.complex128)\n    occupied = [i for i in range(6, 59) if i != 32]\n\
      \    channel[occupied] = np.linspace(9000, 21000, len(occupied)) / (1 << 15)\
      \ * np.exp(\n        1j * np.linspace(-0.45, 0.35, len(occupied)))\n    cfo\
      \ = round(0.002 * (1 << 29)) / float(1 << 29)\n    bins = np.arange(64) - 32\n\
      \    tracked = np.empty((11, 64), dtype=np.complex64)\n    for number in range(11):\n\
      \        ramp = cfo * 20 / 2417 * number * 80 * bins / 64\n        tracked[number]\
      \ = channel * np.exp(1j * (0.08 + 0.012*number - ramp))\n    damaged = np.full((4,\
      \ 64), 0.5, dtype=np.complex64)\n    return np.concatenate((flat, tracked, damaged))\n\
      \n\nclass impairment_profile(gr.sync_block):\n    \"\"\"Emit deterministic per-bin\
      \ channel/CFO coefficients for 47 OFDM vectors.\"\"\"\n\n    def __init__(self,\
      \ algorithm='ls'):\n        gr.sync_block.__init__(\n            self, name='impairment_profile',\
      \ in_sig=None,\n            out_sig=[(np.complex64, 64)])\n        self.algorithm\
      \ = algorithm\n        if Path('build/frame_equalizer_build_mode.txt').exists():\n\
      \            _require_build(algorithm)\n        self.data = _profiles()\n  \
      \      self.position = 0\n\n    def start(self):\n        _require_build(self.algorithm)\n\
      \        return True\n\n    def work(self, input_items, output_items):\n   \
      \     if self.position == len(self.data):\n            return -1\n        count\
      \ = min(len(output_items[0]), len(self.data) - self.position)\n        output_items[0][:count]\
      \ = self.data[self.position:self.position + count]\n        self.position +=\
      \ count\n        return count"
    affinity: ''
    algorithm: algorithm
    alias: ''
    comment: '*epy: deterministic channel/CFO injection plus build validation.'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('impairment_profile', 'impairment_profile', [('algorithm', "'ls'")],
      [], [('0', 'complex', 64)], 'Emit deterministic per-bin channel/CFO coefficients
      for 47 OFDM vectors.', ['algorithm'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 672.0]
    rotation: 0
    state: enabled

