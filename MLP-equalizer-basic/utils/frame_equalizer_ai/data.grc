- name: save_dataset
  id: snippet
  parameters:
    alias: ''
    code: "from pathlib import Path\nimport numpy as np\n\ndata_bins = np.asarray([i\
      \ for i in range(6, 59)\n                        if i not in (11, 25, 32, 39,\
      \ 53)])\nbit_counts = {'bpsk': 1, 'qpsk': 2, 'qam16': 4, 'qam64': 6}\nframe_vectors\
      \ = self.symbols_per_frame + 3\nall_features = np.asarray(self.feature_sink.data(),\
      \ dtype=np.float32).reshape(\n    self.frames, frame_vectors, 64, 3)\nfull_features\
      \ = all_features[:, 3:, :, :].reshape(-1, 64, 3)\nclasses = np.asarray(self.truth_sink.data(),\
      \ dtype=np.uint8).astype(np.int64)\nexpected = self.frames * self.symbols_per_frame\
      \ * 48\nif classes.size != expected:\n    raise RuntimeError(f'truth stream\
      \ has {classes.size} labels; expected {expected}')\nfeatures = full_features[:,\
      \ data_bins, :].reshape(-1, 3)\nlabels = ((classes[:, None] >> np.arange(bit_counts[self.modulation]))\
      \ & 1).astype(\n    np.float32)\noutput = Path(self.output_file)\noutput.parent.mkdir(parents=True,\
      \ exist_ok=True)\nnp.savez(output, features=features, labels=labels, classes=classes,\n\
      \         full_features=full_features)"
    comment: Select payload vectors, pair them with source labels, and write NPZ.
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4112, 624]
    rotation: 0
    state: enabled
