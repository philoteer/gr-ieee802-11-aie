- name: mlir_aie_mlir_aie_cpp_sync_long_test_0
  id: mlir_aie_mlir_aie_cpp_sync_long_test
  parameters:
    N_TILES: vector_size // 1024
    VECTOR_SIZE: vector_size
    affinity: ''
    alias: ''
    comment: ''
    kernel_name: MLIR_AIE
    maxoutbuf: '0'
    minoutbuf: '0'
    num_slots: '1'
    path_insts_bin: build/insts.bin
    path_xclbin: build/final.xclbin
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 160.0]
    rotation: 0
    state: enabled

connections:
- [blocks_file_meta_source_0, '0', blocks_probe_rate_0, '0']
- [blocks_file_meta_source_0, '0', blocks_tag_gate_0, '0']
- [blocks_probe_rate_0, rate, blocks_message_debug_0, log]
- [blocks_tag_gate_0, '0', mlir_aie_complex64_to_cint16_0, '0']
- [mlir_aie_complex64_to_cint16_0, '0', epy_block_0, '0']
- [mlir_aie_complex64_to_cint16_0, '0', mlir_aie_mlir_aie_cpp_sync_long_test_0, '0']
- [mlir_aie_mlir_aie_cpp_sync_long_test_0, '0', blocks_null_sink_0, '0']

