- name: epy_block_0
  id: epy_block
  parameters:
    VECTOR_SIZE: '4096'
    _source_code: "#!/usr/bin/env python\n# -*- coding: utf-8 -*-\n#\n# Copyright\
      \ 2026 gr-mlir_aie author.\n#\n# SPDX-License-Identifier: GPL-3.0-or-later\n\
      #\n\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\n\nfrom aie.dialects.aie\
      \ import *\nfrom aie.extras.context import mlir_mod_ctx\nfrom aie.iron import\
      \ Program, Runtime, Worker, ObjectFifo\nfrom aie.iron.placers import SequentialPlacer\n\
      from aie.iron.controlflow import range_\n\nimport aie.iron as iron\nfrom aie.utils\
      \ import NPUKernel, DefaultNPURuntime, get_current_device\n\nDEV = iron.get_current_device()\n\
      DTYPE_IN=np.int32\nDTYPE_OUT=np.int32\n\nclass mlir_aie_python_int32(gr.basic_block):\n\
      \    \"\"\"\n    docstring for block mlir_aie_python_int32\n    \"\"\"\n   \
      \ def __init__(self, path_xclbin=\"../build/final.xclbin\",path_insts_bin=\"\
      ../build/insts.bin\", VECTOR_SIZE = 4096):\n        gr.basic_block.__init__(self,\n\
      \            name=\"mlir_aie_python_int32\",\n            in_sig=[DTYPE_IN,\
      \ ],\n            out_sig=[DTYPE_OUT, ])\n            \n        npu_kernel =\
      \ NPUKernel(\n            path_xclbin,\n            path_insts_bin,\n      \
      \      kernel_name=\"MLIR_AIE\",\n        )\n        \n        self.set_tag_propagation_policy(gr.TPP_DONT)\n\
      \        \n        self.kernel_handle = DefaultNPURuntime.load(npu_kernel)\n\
      \        self.OUT_SAMPLE_OFFSET = 320\n        self.VECTOR_SIZE = VECTOR_SIZE\n\
      \        self.TILE_SIZE = VECTOR_SIZE // 4\n        self.OUT_TILE_SIZE = self.TILE_SIZE\
      \ + self.OUT_SAMPLE_OFFSET\n        self.OUT_VECTOR_SIZE = self.OUT_TILE_SIZE\
      \ * 4\n        self.out_buf = iron.zeros(self.OUT_VECTOR_SIZE, dtype=DTYPE_OUT)\n\
      \        self.MAX_TAGS_PER_TILE = 7\n        self.METADATA_WORDS_PER_TILE =\
      \ 2 + 2 * self.MAX_TAGS_PER_TILE\n        self.out_meta_buf = iron.zeros(4 *\
      \ self.METADATA_WORDS_PER_TILE, dtype=np.int32)\n        self.tag_key = pmt.intern(\"\
      wifi_start\")\n        self.tag_srcid = pmt.intern(\"sync_short\")\n\n    #TODO\
      \ implement forecast()\n    def forecast(self, noutput_items, ninputs):\n  \
      \      #ninput_items_required = [min(self.VECTOR_SIZE, noutput_items)] * ninputs\n\
      \        ninput_items_required = [noutput_items] * ninputs   \n        return\
      \ ninput_items_required\n\n    def general_work(self, input_items, output_items):\n\
      \        in0 = input_items[0]\n        out0 = output_items[0]\n        \n  \
      \      n_input_items = len(in0)\n        n_output_items = len(out0)\n      \
      \  \n        n_chunks = min(n_input_items // self.VECTOR_SIZE, n_output_items\
      \ // self.VECTOR_SIZE)\n\n        if n_chunks == 0:\n            return 0\n\n\
      \        total_produced = 0\n        for i in range(n_chunks):\n           \
      \ start_idx = i * self.VECTOR_SIZE\n            end_idx = start_idx + self.VECTOR_SIZE\n\
      \            \n            current_in_tensor = iron.tensor(in0[start_idx:end_idx],\
      \ dtype=DTYPE_IN)\n            buffers = [current_in_tensor, self.out_buf, self.out_meta_buf]\n\
      \            DefaultNPURuntime.run(self.kernel_handle, buffers)\n\n        \
      \    out_np = self.out_buf.numpy()\n            out_meta = self.out_meta_buf.numpy().reshape(4,\
      \ self.METADATA_WORDS_PER_TILE)\n            output_abs_start = self.nitems_written(0)\n\
      \            for tile_idx, tile_meta in enumerate(out_meta):\n             \
      \   tile_len = int(tile_meta[0])\n                tag_count = min(int(tile_meta[1]),\
      \ self.MAX_TAGS_PER_TILE)\n                tile_start = tile_idx * self.OUT_TILE_SIZE\
      \ + self.OUT_SAMPLE_OFFSET\n                tile_end = tile_start + tile_len\n\
      \                next_total_produced = total_produced + tile_len\n         \
      \       out0[total_produced:next_total_produced] = out_np[tile_start:tile_end]\n\
      \n                tile_abs_start = output_abs_start + total_produced\n     \
      \           for tag_idx in range(tag_count):\n                    tag_offset\
       \ = int(tile_meta[2 + 2 * tag_idx])\n                    tag_value = float(tile_meta[3\
       \ + 2 * tag_idx]) / (1 << 29)\n                    if 0 <= tag_offset\
      \ < tile_len:\n                        self.add_item_tag(\n                \
      \            0,\n                            tile_abs_start + tag_offset,\n\
      \                            self.tag_key,\n                            pmt.from_double(tag_value),\n\
      \                            self.tag_srcid,\n                        )\n\n\
      \                total_produced = next_total_produced\n        \n        total_processed\
      \ = n_chunks * self.VECTOR_SIZE\n        self.consume_each(total_processed)\n\
      \        \n        return total_produced\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    path_insts_bin: '"../build/insts.bin"'
    path_xclbin: '"../build/final.xclbin"'
  states:
    _io_cache: ('mlir_aie_python_int32', 'mlir_aie_python_int32', [('path_xclbin',
      "'../build/final.xclbin'"), ('path_insts_bin', "'../build/insts.bin'"), ('VECTOR_SIZE',
      '4096')], [('0', 'int', 1)], [('0', 'int', 1)], '\n    docstring for block mlir_aie_python_int32\n    ',
      ['VECTOR_SIZE'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 296.0]
    rotation: 0
    state: enabled
