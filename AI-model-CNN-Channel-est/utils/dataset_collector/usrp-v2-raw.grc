- name: epy_raw_metadata
  id: epy_block
  parameters:
    _source_code: "import json\nimport math\nimport os\nfrom pathlib import Path\n\
      import threading\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\
      \n\nclass raw_metadata(gr.sync_block):\n    def __init__(self, output_path='out.sigmf-meta',\
      \ sample_rate=20e6,\n                 frequency=2.412e9, gain=44):\n       \
      \ gr.sync_block.__init__(self, name='raw_metadata',\n                      \
      \         in_sig=[np.complex64], out_sig=[])\n        self.path = Path(output_path)\n\
      \        self.lock = threading.Lock()\n        self.pending = []\n        self.started\
      \ = False\n        self._recorded_frequency = float(frequency)\n        self._recorded_gain\
      \ = float(gain)\n        self.metadata = {\n            'global': {\n      \
      \          'core:datatype': 'ci16_le',\n                'core:sample_rate':\
      \ float(sample_rate),\n                'core:version': '1.2.6',\n          \
      \      'core:dataset': 'out.sigmf-data',\n                'core:hw': 'USRP B210\
      \ (UHD), TX/RX',\n                'core:recorder': 'wifi_rx_usrp raw_metadata',\n\
      \                'core:description': 'RX antenna TX/RX; complex float quantized\
      \ to int16 with scale 32768',\n            },\n            'captures': [{'core:sample_start':\
      \ 0,\n                          'core:frequency': self._recorded_frequency}],\n\
      \            'annotations': [{'core:sample_start': 0, 'core:label': 'rx-gain',\n\
      \                             'core:comment': 'rx_gain_db={:g}'.format(self._recorded_gain)}],\n\
      \        }\n    def _save(self):\n        self.path.parent.mkdir(parents=True,\
      \ exist_ok=True)\n        temporary = self.path.with_name(self.path.name + '.tmp')\n\
      \        with temporary.open('w', encoding='utf-8') as output:\n           \
      \ json.dump(self.metadata, output, indent=2)\n            output.write('\\n')\n\
      \        os.replace(temporary, self.path)\n\n    def record_change(self, offset,\
      \ frequency=None, gain=None):\n        with self.lock:\n            self.pending.append((int(offset),\
      \ frequency, gain))\n\n    def work(self, input_items, output_items):\n    \
      \    count = len(input_items[0])\n        if not self.started:\n           \
      \ self.started = True\n            self._save()\n        start = self.nitems_read(0)\n\
      \        stop = start + count\n        with self.lock:\n            ready =\
      \ [event for event in self.pending if event[0] < stop]\n            self.pending\
      \ = [event for event in self.pending if event[0] >= stop]\n        events =\
      \ {}\n        for offset, frequency, gain in ready:\n            event = events.setdefault(max(start,\
      \ offset), {})\n            if frequency is not None:\n                event['frequency']\
      \ = float(frequency)\n            if gain is not None:\n                event['gain']\
      \ = float(gain)\n        for tag in self.get_tags_in_window(0, 0, count):\n\
      \            key = pmt.symbol_to_string(tag.key)\n            offset = int(tag.offset)\n\
      \            event = events.setdefault(offset, {})\n            if key == 'rx_freq'\
      \ and pmt.is_real(tag.value):\n                event['frequency'] = float(pmt.to_double(tag.value))\n\
      \            elif key == 'rx_gain' and pmt.is_real(tag.value):\n           \
      \     event['gain'] = float(pmt.to_double(tag.value))\n            elif key\
      \ == 'rx_time' and pmt.is_tuple(tag.value):\n                seconds = pmt.tuple_ref(tag.value,\
      \ 0)\n                fraction = pmt.tuple_ref(tag.value, 1)\n             \
      \   if pmt.is_uint64(seconds) and pmt.is_real(fraction):\n                 \
      \   event['time'] = (pmt.to_uint64(seconds) +\n                            \
      \         pmt.to_double(fraction))\n        changed = False\n        for offset,\
      \ event in sorted(events.items()):\n            frequency = event.get('frequency')\n\
      \            if frequency is not None and math.isfinite(frequency) and frequency\
      \ != self._recorded_frequency:\n                self._recorded_frequency = frequency\n\
      \                if offset == self.metadata['captures'][-1]['core:sample_start']:\n\
      \                    self.metadata['captures'][-1]['core:frequency'] = frequency\n\
      \                else:\n                    self.metadata['captures'].append({\n\
      \                        'core:sample_start': offset, 'core:frequency': frequency})\n\
      \                changed = True\n            gain = event.get('gain')\n    \
      \        if gain is not None and math.isfinite(gain) and gain != self._recorded_gain:\n\
      \                self._recorded_gain = gain\n                annotation = {'core:sample_start':\
      \ offset, 'core:label': 'rx-gain',\n                              'core:comment':\
      \ 'rx_gain_db={:g}'.format(gain)}\n                if offset == 0:\n       \
      \             self.metadata['annotations'][0] = annotation\n               \
      \ else:\n                    self.metadata['annotations'].append(annotation)\n\
      \                changed = True\n            if 'time' in event:\n         \
      \       self.metadata['annotations'].append({\n                    'core:sample_start':\
      \ offset, 'core:label': 'rx-time',\n                    'core:comment': 'rx_time={:.9f}'.format(event['time'])})\n\
      \                changed = True\n        if changed:\n            self._save()\n\
      \        return count\n\n    def stop(self):\n        if self.started:\n   \
      \         self._save()\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    frequency: freq
    gain: gain
    maxoutbuf: '0'
    minoutbuf: '0'
    output_path: '"out.sigmf-meta"'
    sample_rate: samp_rate
  states:
    _io_cache: ('raw_metadata', 'raw_metadata', [('output_path', "'out.sigmf-meta'"),
      ('sample_rate', '20000000.0'), ('frequency', '2412000000.0'), ('gain', '44')],
      [('0', 'complex', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 192.0]
    rotation: 0
    state: enabled
- name: start_channel_sweep
  id: snippet
  parameters:
    alias: ''
    code: "import math\nimport random\nimport threading\nimport time\n\nself.channel_sweep_stop\
      \ = threading.Event()\nif len(self.initial_gains) != 13:\n    raise ValueError('initial_gains\
      \ must contain 13 channel values')\nself.channel_gain_lut = {channel: self.initial_gains[channel\
      \ - 1]\n                         for channel in range(1, 14)}\ngain_range =\
      \ self.uhd_usrp_source_0.get_gain_range(0)\n\ndef observe(duration):\n    warmup\
      \ = min(max(0.0, float(self.gain_settle_s)), duration / 3)\n    if self.channel_sweep_stop.wait(warmup):\n\
      \        return None\n    deadline = time.monotonic() + duration - warmup\n\
      \    power_sum = 0.0\n    near_full_sum = 0.0\n    count = 0\n    while not\
      \ self.channel_sweep_stop.is_set():\n        remaining = deadline - time.monotonic()\n\
      \        if remaining <= 0:\n            break\n        if self.channel_sweep_stop.wait(min(0.1,\
      \ remaining)):\n            return None\n        power = self.blocks_probe_power.level()\
      \ / 2048\n        near_full = self.blocks_probe_clip.level() / 2048\n      \
      \  if math.isfinite(power) and power > 0 and 0 <= near_full <= 1:\n        \
      \    power_sum += power\n            near_full_sum += near_full\n          \
      \  count += 1\n    if count == 0:\n        return None\n    return math.sqrt(power_sum\
      \ / count), near_full_sum / count, count\n\ndef record_settings():\n    self.epy_raw_metadata.record_change(\n\
      \        self.uhd_usrp_source_0.nitems_written(0),\n        self.uhd_usrp_source_0.get_center_freq(0),\n\
      \        self.uhd_usrp_source_0.get_gain(0))\n\ndef sweep():\n    while not\
      \ self.channel_sweep_stop.is_set():\n        for channel in range(1, 14):\n\
      \            if self.channel_sweep_stop.is_set():\n                return\n\
      \            frequency = 2.412e9 + (channel - 1) * 5e6\n            dwell =\
      \ max(0.02, float(self.popular_dwell_s if channel in (1, 5, 9, 13)\n       \
      \                             else self.other_dwell_s))\n            if self.get_freq()\
      \ != frequency:\n                self.set_freq(frequency)\n                record_settings()\n\
      \            self.set_gain(self.channel_gain_lut[channel])\n            record_settings()\n\
      \            print('Wi-Fi channel {}: {:.0f} MHz, gain {:.1f} dB, dwell {} s'.format(\n\
      \                channel, frequency / 1e6, self.uhd_usrp_source_0.get_gain(0),\
      \ dwell),\n                flush=True)\n            level = observe(dwell /\
      \ 2)\n            if level is not None:\n                rms, near_full, count\
      \ = level\n                if rms > 0 and math.isfinite(rms):\n            \
      \        delta = 6.0 if rms < 0.14 else (-6.0 if rms > 0.28 else 0.0)\n    \
      \                if near_full > 1e-4:\n                        delta = min(delta,\
      \ -6.0)\n                    noise = random.gauss(0, max(0.0, float(self.gain_noise_std_db)))\n\
      \                    candidate = max(gain_range.start(), min(gain_range.stop(),\n\
      \                        self.channel_gain_lut[channel] + delta + noise))\n\
      \                    self.set_gain(candidate)\n                    record_settings()\n\
      \                    self.channel_gain_lut[channel] = self.uhd_usrp_source_0.get_gain(0)\n\
      \                    print('Wi-Fi channel {}: rms {:.3f}, near full scale {:.4%}\
      \ of {} polls, gain {:.1f} dB'.format(\n                        channel, rms,\
      \ near_full, count, self.channel_gain_lut[channel]),\n                     \
      \   flush=True)\n            if self.channel_sweep_stop.wait(dwell / 2):\n \
      \               return\n\nself.channel_sweep_thread = threading.Thread(target=sweep,\
      \ daemon=True)\nself.channel_sweep_thread.start()\n"
    comment: ''
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 96.0]
    rotation: 0
    state: enabled
- name: stop_channel_sweep
  id: snippet
  parameters:
    alias: ''
    code: 'self.channel_sweep_stop.set()

      self.channel_sweep_thread.join(timeout=1)'
    comment: ''
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 96.0]
    rotation: 0
    state: enabled
