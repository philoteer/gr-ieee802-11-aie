- name: start_channel_sweep
  id: snippet
  parameters:
    alias: ''
    code: "import math\nimport random\nimport threading\nimport time\nself.channel_sweep_stop\
      \ = threading.Event()\nif len(self.initial_gains) != 13:\n    raise ValueError('initial_gains must contain 13 channel values')\nself.channel_gain_lut = {channel: self.initial_gains[channel - 1]\n\
      \                         for channel in range(1, 14)}\ngain_range = self.uhd_usrp_source_0.get_gain_range(0)\n\
      \ndef observe(duration):\n    warmup = min(max(0.0, float(self.gain_settle_s)),\
      \ duration / 3)\n    if self.channel_sweep_stop.wait(warmup):\n        return\
      \ None\n    deadline = time.monotonic() + duration - warmup\n    power_sum =\
      \ 0.0\n    near_full_sum = 0.0\n    count = 0\n    while not self.channel_sweep_stop.is_set():\n\
      \        remaining = deadline - time.monotonic()\n        if remaining <= 0:\n\
      \            break\n        if self.channel_sweep_stop.wait(min(0.1, remaining)):\n\
      \            return None\n        power = self.blocks_probe_power.level() /\
      \ 2048\n        near_full = self.blocks_probe_clip.level() / 2048\n        if\
      \ math.isfinite(power) and power > 0 and 0 <= near_full <= 1:\n            power_sum\
      \ += power\n            near_full_sum += near_full\n            count += 1\n\
      \    if count == 0:\n        return None\n    return math.sqrt(power_sum / count),\
      \ near_full_sum / count, count\n\ndef sweep():\n    while not self.channel_sweep_stop.is_set():\n\
      \        for channel in range(1, 14):\n            if self.channel_sweep_stop.is_set():\n\
      \                return\n            frequency = 2.412e9 + (channel - 1) * 5e6\n\
      \            dwell = max(0.02, float(self.popular_dwell_s if channel in (1,\
      \ 5, 9, 13)\n                                    else self.other_dwell_s))\n\
      \            self.epy_xy_collector.mute_for(max(0.0, float(self.gain_settle_s)))\n\
      \            if self.get_freq() != frequency:\n                self.set_freq(frequency)\n\
      \            self.set_gain(self.channel_gain_lut[channel])\n            self.epy_xy_collector.mute_for(max(0.0,\
      \ float(self.gain_settle_s)))\n            print('Wi-Fi channel {}: {:.0f} MHz,\
      \ gain {:.1f} dB, dwell {} s'.format(\n                channel, frequency /\
      \ 1e6, self.uhd_usrp_source_0.get_gain(0), dwell),\n                flush=True)\n\
      \            level = observe(dwell / 2)\n            if level is not None:\n\
      \                rms, near_full, count = level\n                if rms > 0 and math.isfinite(rms):\n\
      \                    delta = 6.0 if rms < 0.14 else (-6.0 if rms > 0.28 else 0.0)\n\
      \                    if near_full > 1e-4:\n                        delta = min(delta,\
      \ -6.0)\n                    noise = random.gauss(0, max(0.0, float(self.gain_noise_std_db)))\n\
      \                    candidate = max(gain_range.start(), min(gain_range.stop(),\n\
      \                        self.channel_gain_lut[channel] + delta + noise))\n\
      \                    self.epy_xy_collector.mute_for(max(0.0, float(self.gain_settle_s)))\n\
      \                    self.set_gain(candidate)\n                    self.epy_xy_collector.mute_for(max(0.0,\
      \ float(self.gain_settle_s)))\n                    self.channel_gain_lut[channel]\
      \ = self.uhd_usrp_source_0.get_gain(0)\n                    print('Wi-Fi channel\
      \ {}: rms {:.3f}, near full scale {:.4%} of {} polls, gain {:.1f} dB'.format(\n\
      \                        channel, rms, near_full, count, self.channel_gain_lut[channel]),\n\
      \                        flush=True)\n            if self.channel_sweep_stop.wait(dwell\
      \ / 2):\n                return\n\nself.channel_sweep_thread = threading.Thread(target=sweep,\
      \ daemon=True)\nself.channel_sweep_thread.start()"
    comment: ''
    priority: '0'
