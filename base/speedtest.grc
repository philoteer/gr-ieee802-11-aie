    num_slots: '2'
    path_insts_bin: /home/piloteer/xdna_phy/gr-ieee802-11-aie/Experiments/latency_profile/null_kernel/build/insts.bin
    path_xclbin: /home/piloteer/xdna_phy/gr-ieee802-11-aie/Experiments/latency_profile/null_kernel/build/final.xclbin
