    rotation: 0
    state: enabled
- name: data_dir
  id: variable
  parameters:
    comment: Dataset paths are relative to the generated script in base/test/magsq_avg_cf.
    value: str(__import__("pathlib").Path(globals().get("__file__", "base/test/magsq_avg_cf/wifi_rx.py")).resolve().parents[3]
      / "AI-model-CNN-Channel-est" / "data")
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 16.0]
    rotation: 0
    state: enabled
