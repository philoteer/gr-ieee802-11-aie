options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: wifi_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: bash -c 'export LD_LIBRARY_PATH="$(dirname "$2")/../../../../gr-foo-fixed/build/lib${{LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}}";
      exec "$1" -u "$2"' -- {python} {filename}
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ''
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 12.0]
    rotation: 0
    state: enabled

blocks:
- name: data_dir
  id: variable
  parameters:
    comment: Dataset paths are relative to the generated script in base/test/autocorr_cf.
    value: str(__import__("pathlib").Path(globals().get("__file__", "base/test/autocorr_cf/wifi_rx.py")).resolve().parents[3]
      / "AI-model-CNN-Channel-est" / "data")
  states:
    coordinate: [960, 16.0]
    rotation: 0
    state: enabled
- name: file_path
  id: variable
  parameters:
    comment: ''
    value: data_dir + "/raw_capture/stress_test.sigmf"
  states:
    coordinate: [960, 208.0]
    rotation: 0
    state: disabled
- name: file_path
  id: variable
  parameters:
    comment: ''
    value: data_dir + "/raw_capture/room_20260927.sigmf"
