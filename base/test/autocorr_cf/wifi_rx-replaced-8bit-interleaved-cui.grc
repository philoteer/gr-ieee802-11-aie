    coordinate: [960, 80.0]
    rotation: 0
    state: enabled
- name: kernel_dir
  id: variable
  parameters:
    comment: Standalone autocorrelation kernel built by the local Makefile.
    value: str(__import__("pathlib").Path(globals().get("__file__", "base/test/autocorr_cf/wifi_rx.py")).resolve().parent
      / "build")
  states:
    coordinate: [960, 144.0]
    rotation: 0
    state: enabled
- name: chan_est
  id: variable
  parameters:
    comment: ''
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [168, 8.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: 2.417e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 8.0]
    rotation: 0
    state: enabled
- name: samp_rate
