- name: epy_block_latency
  id: epy_block
  parameters:
    _source_code: |
      import json
      import threading
      import time

      import numpy as np
      import pmt
      from gnuradio import gr


      class blk(gr.sync_block):
          """Match input boundary tags to CRC-valid decoded MAC payloads."""

          def __init__(self, metadata_file="../wifi_latency.sigmf-meta"):
              gr.sync_block.__init__(self, name="PHY latency (payload match)",
                                     in_sig=[np.complex64], out_sig=[np.complex64])
              with open(metadata_file) as stream:
                  metadata = json.load(stream)
              self.by_payload = {}
              self.frames = {}
              for annotation in metadata.get("annotations", []):
                  label = annotation.get("core:label", "")
                  if not label.startswith("wifi-frame-"):
                      continue
                  info = json.loads(annotation["core:comment"])
                  payload = info["payload_ascii"].encode("ascii")
                  if payload in self.by_payload or label in self.frames:
                      raise ValueError("Latency matching requires unique frame IDs and payloads")
                  self.by_payload[payload] = (label, info["mac_sequence_number"])
                  self.frames[label] = {}
              if not self.frames:
                  raise ValueError("No annotated Wi-Fi latency frames found")
              self.lock = threading.Lock()
              self.count = 0
              self.total_ms = 0.0
              self.unmatched = 0
              self.duplicates = 0
              self.message_port_register_in(pmt.intern("decoded"))
              self.set_msg_handler(pmt.intern("decoded"), self.handle_decoded)

          def work(self, input_items, output_items):
              count = len(input_items[0])
              # Read tags inline, before releasing these samples to the receiver.
              # Keep timestamps out-of-band; sync/equalizer blocks may drop tags.
              with self.lock:
                  for tag in self.get_tags_in_window(0, 0, count):
                      if not any(pmt.eq(tag.key, pmt.intern(k)) for k in ("frame_start", "frame_end")):
                          continue
                      if not pmt.is_dict(tag.value):
                          continue
                      label = pmt.dict_ref(tag.value, pmt.intern("frame_id"), pmt.PMT_NIL)
                      stamp = pmt.dict_ref(tag.value, pmt.intern("timestamp_ns"), pmt.PMT_NIL)
                      if not pmt.is_symbol(label) or not pmt.is_uint64(stamp):
                          continue
                      label = pmt.symbol_to_string(label)
                      if label in self.frames:
                          event = "start" if pmt.eq(tag.key, pmt.intern("frame_start")) else "end"
                          self.frames[label].setdefault(event, pmt.to_uint64(stamp))
                          self.report(label)
              output_items[0][:count] = input_items[0][:count]
              return count

          def handle_decoded(self, message):
              # Timestamp at handler entry, before matching/printing/locking.
              completed = time.monotonic_ns()
              if not pmt.is_pair(message):
                  return
              data = pmt.cdr(message)
              if not (pmt.is_blob(data) or pmt.is_u8vector(data)):
                  return
              mac = bytes(pmt.to_python(data))
              match = self.by_payload.get(mac[24:]) if len(mac) >= 24 else None
              with self.lock:
                  if match is None or int.from_bytes(mac[22:24], "little") >> 4 != match[1]:
                      self.unmatched += 1
                      return
                  label = match[0]
                  frame = self.frames[label]
                  if "done" in frame:
                      self.duplicates += 1
                      return
                  frame["done"] = completed
                  self.report(label)

          def report(self, label):
              # Called with lock held. Output delivery can precede the annotation's
              # final windowing-tail tag, so retain completion until both tags exist.
              frame = self.frames[label]
              if frame.get("reported") or not all(k in frame for k in ("start", "end", "done")):
                  return
              elapsed_ms = (frame["done"] - frame["start"]) / 1e6
              tail_ms = (frame["done"] - frame["end"]) / 1e6
              frame["reported"] = True
              self.count += 1
              self.total_ms += elapsed_ms
              print(f"[PHY latency estimate] {label}: "
                    f"start-to-decoded={elapsed_ms:.4f} ms, "
                    f"end-to-decoded={tail_ms:.4f} ms, "
                    f"mean={self.total_ms / self.count:.4f} ms (n={self.count})",
                    flush=True)

          def finish(self):
              with self.lock:
                  missing = [label for label, frame in self.frames.items() if not frame.get("reported")]
                  print(f"[PHY latency summary] matched={self.count}/{len(self.frames)}, "
                        f"unmatched-output={self.unmatched}, duplicate-output={self.duplicates}", flush=True)
                  if missing:
                      print("[PHY latency summary] missing: " + ", ".join(missing), flush=True)
    metadata_file: file_path+"-meta"
    affinity: ''
    alias: ''
    comment: Input tags are matched to decoded payload IDs without PHY tag propagation.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1840, 252.0]
    rotation: 0
    state: enabled
