- name: epy_block_latency
  id: epy_block
  parameters:
    _source_code: "import json\nimport threading\nimport time\nimport zlib\n\nimport\
      \ pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    \"\"\"Match\
      \ native ingress and GR-WiFi equalizer timestamps without IQ work.\n\n    Input\
      \ boundaries retain the injector's timestamp_ns. Completion uses\n    phy_equalized_ns\
      \ stamped on the final demodulated output symbol.\n    Payload decoding only\
      \ identifies the frame and carries that time unchanged.\n    Decoding, Python\
      \ delivery, matching, and printing are outside the interval.\n\n    Attributes:\n\
      \        by_payload (dict): Payload bytes mapped to frame label and sequence.\n\
      \        frames (dict): Frame labels mapped to native start/end/done timestamps\n\
      \            in nanoseconds, diagnostic observed time, and a reported flag.\n\
      \        lock (threading.Lock): Protects frame state and counters.\n       \
      \ count (int): Number of reported frames.\n        total_ms (float): Sum of\
      \ reported start-to-equalized latencies.\n        unmatched (int): Packets without\
      \ a matching payload and sequence.\n        duplicates (int): Additional decoded\
      \ packets for an already seen ID.\n        malformed (int): Data packets with\
      \ invalid envelope length or FCS.\n    \"\"\"\n\n    def __init__(self, metadata_file=\"\
      ../wifi_latency.sigmf-meta\"):\n        \"\"\"Load expected identities and register\
      \ message inputs.\n\n        Args:\n            metadata_file (str): SigMF metadata\
      \ containing wifi-frame-...\n                annotations with payload_ascii\
      \ and mac_sequence_number in\n                each annotation's JSON core:comment.\n\
      \n        Raises:\n            OSError: If metadata cannot be read.\n      \
      \      ValueError: If JSON is invalid, no frames exist, or labels or\n     \
      \           payloads are ambiguous.\n            KeyError: If required identity\
      \ fields are missing.\n        \"\"\"\n        gr.basic_block.__init__(self,\
      \ name=\"GR-WiFi PHY latency\",\n                                in_sig=None,\
      \ out_sig=None)\n        with open(metadata_file) as stream:\n            metadata\
      \ = json.load(stream)\n        self.by_payload = {}\n        self.frames = {}\n\
      \        for annotation in metadata.get(\"annotations\", []):\n            label\
      \ = annotation.get(\"core:label\", \"\")\n            if not label.startswith(\"\
      wifi-frame-\"):\n                continue\n            info = json.loads(annotation[\"\
      core:comment\"])\n            payload = info[\"payload_ascii\"].encode(\"ascii\"\
      )\n            if payload in self.by_payload or label in self.frames:\n    \
      \            raise ValueError(\"Latency matching requires unique frame IDs and\
      \ payloads\")\n            self.by_payload[payload] = (label, info[\"mac_sequence_number\"\
      ])\n            self.frames[label] = {}\n        if not self.frames:\n     \
      \       raise ValueError(\"No annotated Wi-Fi latency frames found\")\n    \
      \    self.lock = threading.Lock()\n        self.count = 0\n        self.total_ms\
      \ = 0.0\n        self.unmatched = 0\n        self.duplicates = 0\n        self.malformed\
      \ = 0\n        self.message_port_register_in(pmt.intern(\"boundaries\"))\n \
      \       self.set_msg_handler(pmt.intern(\"boundaries\"), self.handle_boundary)\n\
      \        self.message_port_register_in(pmt.intern(\"decoded\"))\n        self.set_msg_handler(pmt.intern(\"\
      decoded\"), self.handle_decoded)\n\n    def handle_boundary(self, message):\n\
      \        \"\"\"Retain an original native timestamp regardless of delivery time.\n\
      \n        Args:\n            message (pmt.pmt_t): Pair of frame_start/frame_end\
      \ and a metadata\n                dictionary with frame_id and timestamp_ns.\
      \ Invalid or unknown\n                events are ignored.\n        \"\"\"\n\
      \        if not pmt.is_pair(message):\n            return\n        key, value\
      \ = pmt.car(message), pmt.cdr(message)\n        if not pmt.is_dict(value):\n\
      \            return\n        if pmt.eq(key, pmt.intern(\"frame_start\")):\n\
      \            event = \"start\"\n        elif pmt.eq(key, pmt.intern(\"frame_end\"\
      )):\n            event = \"end\"\n        else:\n            return\n      \
      \  label = pmt.dict_ref(value, pmt.intern(\"frame_id\"), pmt.PMT_NIL)\n    \
      \    stamp = pmt.dict_ref(value, pmt.intern(\"timestamp_ns\"), pmt.PMT_NIL)\n\
      \        if not pmt.is_symbol(label) or not pmt.is_uint64(stamp):\n        \
      \    return\n        label = pmt.symbol_to_string(label)\n        with self.lock:\n\
      \            if label in self.frames:\n                self.frames[label].setdefault(event,\
      \ pmt.to_uint64(stamp))\n                self.report(label)\n\n    def handle_decoded(self,\
      \ message):\n        \"\"\"Unwrap a CRC-valid GR-WiFi packet and match its native\
      \ completion.\n\n        GR-WiFi emits format (1 byte), PSDU length (2 bytes,\
      \ little-endian),\n        PSDU including FCS, and MCS (1 byte). This experiment\
      \ uses 24-byte\n        MAC headers. Channel-report PDUs are ignored. The first\
      \ completion\n        for a matching payload/sequence wins, even if boundaries\
      \ arrive later.\n\n        Args:\n            message (pmt.pmt_t): Decoder PDU\
      \ carrying phy_equalized_ns metadata\n                and a blob/u8vector containing\
      \ the GR-WiFi envelope.\n\n        Raises:\n            RuntimeError: If a valid\
      \ data packet lacks a native timestamp,\n                usually because the\
      \ system decoder was loaded by mistake.\n        \"\"\"\n        observed =\
      \ time.monotonic_ns()  # Diagnostic only, never the endpoint.\n        if not\
      \ pmt.is_pair(message):\n            return\n        data = pmt.cdr(message)\n\
      \        if not (pmt.is_blob(data) or pmt.is_u8vector(data)):\n            return\n\
      \        packet = bytes(pmt.to_python(data))\n        if not packet or packet[0]\
      \ not in (0, 1, 2):\n            return  # Not a legacy/HT/VHT decoded data\
      \ packet.\n        length = int.from_bytes(packet[1:3], \"little\")\n      \
      \  if length < 28 or len(packet) != length + 4 or zlib.crc32(packet[3:3 + length])\
      \ != 0x2144df1c:\n            with self.lock:\n                self.malformed\
      \ += 1\n            return\n        metadata = pmt.car(message)\n        completed\
      \ = pmt.dict_ref(metadata, pmt.intern(\"phy_equalized_ns\"), pmt.PMT_NIL) if\
      \ pmt.is_dict(metadata) else pmt.PMT_NIL\n        if not pmt.is_uint64(completed):\n\
      \            raise RuntimeError(\"PDU lacks phy_equalized_ns; source ./local-env.sh\"\
      )\n        completed = pmt.to_uint64(completed)\n        mac = packet[3:3 +\
      \ length - 4]  # Remove envelope and four-byte FCS.\n        match = self.by_payload.get(mac[24:])\n\
      \        with self.lock:\n            if match is None or int.from_bytes(mac[22:24],\
      \ \"little\") >> 4 != match[1]:\n                self.unmatched += 1\n     \
      \           return\n            label = match[0]\n            frame = self.frames[label]\n\
      \            if \"done\" in frame:\n                self.duplicates += 1\n \
      \               return\n            frame[\"done\"] = completed\n          \
      \  frame[\"observed\"] = observed\n            self.report(label)\n\n    def\
      \ report(self, label):\n        \"\"\"Print a sample once both boundaries and\
      \ completion are available.\n\n        The caller must hold self.lock. Either\
      \ message input may arrive\n        first; stored native timestamps are never\
      \ replaced by arrival times.\n\n        Args:\n            label (str): Known\
      \ annotated frame label.\n        \"\"\"\n        frame = self.frames[label]\n\
      \        if frame.get(\"reported\") or not all(k in frame for k in (\"start\"\
      , \"end\", \"done\")):\n            return\n        elapsed_ms = (frame[\"done\"\
      ] - frame[\"start\"]) / 1e6\n        tail_ms = (frame[\"done\"] - frame[\"end\"\
      ]) / 1e6\n        frame[\"reported\"] = True\n        self.count += 1\n    \
      \    self.total_ms += elapsed_ms\n        print(f\"[PHY latency estimate] {label}:\
      \ \"\n              f\"start-to-equalized={elapsed_ms:.4f} ms, \"\n        \
      \      f\"end-to-equalized={tail_ms:.4f} ms, \"\n              f\"mean={self.total_ms\
      \ / self.count:.4f} ms (n={self.count})\",\n              flush=True)\n\n  \
      \  def finish(self):\n        \"\"\"Print matching counters and missing IDs\
      \ after top_block.wait().\"\"\"\n        with self.lock:\n            missing\
      \ = [label for label, frame in self.frames.items() if not frame.get(\"reported\"\
      )]\n            print(f\"[PHY latency summary] matched={self.count}/{len(self.frames)},\
      \ \"\n                  f\"unmatched-output={self.unmatched}, duplicate-output={self.duplicates},\
      \ \"\n                  f\"malformed-output={self.malformed}\", flush=True)\n\
      \            if missing:\n                print(\"[PHY latency summary] missing:\
      \ \" + \", \".join(missing), flush=True)\n"
    affinity: ''
    alias: ''
    comment: Message-only reporter using native input and completion timestamps.
    maxoutbuf: '0'
    metadata_file: file_path+"-meta"
    minoutbuf: '0'
  states:
    _io_cache: '(''GR-WiFi PHY latency'', ''blk'', [(''metadata_file'', "''../wifi_latency.sigmf-meta''")],
      [(''decoded'', ''message'', 1), (''boundaries'', ''message'', 1)], [], "Match
      native ingress and GR-WiFi equalizer timestamps without IQ work.\n\n    Input
      boundaries retain the injector''s timestamp_ns. Completion uses\n    phy_equalized_ns
      stamped on the final demodulated output symbol.\n    Payload decoding only identifies
      the frame and carries that time unchanged.\n    Decoding, Python delivery, matching,
      and printing are outside the interval.\n\n    Attributes:\n        by_payload
      (dict): Payload bytes mapped to frame label and sequence.\n        frames (dict):
      Frame labels mapped to native start/end/done timestamps\n            in nanoseconds,
      diagnostic observed time, and a reported flag.\n        lock (threading.Lock):
      Protects frame state and counters.\n        count (int): Number of reported
      frames.\n        total_ms (float): Sum of reported start-to-equalized latencies.\n        unmatched
      (int): Packets without a matching payload and sequence.\n        duplicates
      (int): Additional decoded packets for an already seen ID.\n        malformed
      (int): Data packets with invalid envelope length or FCS.\n    ", [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1376, 352.0]
    rotation: 0
    state: enabled
