- name: epy_block_latency
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Print host-side PHY chunk-completion latency for annotated frames.\"\
      \"\"\n\n    def __init__(self):\n        gr.basic_block.__init__(self, name=\"\
      PHY latency\", in_sig=None, out_sig=None)\n        self.starts = {}\n      \
      \  self.count = 0\n        self.total_ms = 0.0\n        self.message_port_register_in(pmt.intern(\"\
      latency\"))\n        self.set_msg_handler(pmt.intern(\"latency\"), self.handle_latency)\n\
      \n    def handle_latency(self, message):\n        if not pmt.is_pair(message):\n\
      \            return\n        key, value = pmt.car(message), pmt.cdr(message)\n\
      \        if not pmt.is_symbol(key) or not pmt.is_dict(value):\n            return\n\
      \        event = pmt.symbol_to_string(key)\n        if event not in (\"frame_start\"\
      , \"frame_end\"):\n            return\n        frame_id = pmt.dict_ref(value,\
      \ pmt.intern(\"frame_id\"), pmt.PMT_NIL)\n        times = pmt.dict_ref(value,\
      \ pmt.intern(\"timestamps_ns\"), pmt.PMT_NIL)\n        if not pmt.is_symbol(frame_id)\
      \ or not pmt.is_dict(times):\n            return\n        start = pmt.dict_ref(times,\
      \ pmt.intern(\"phy_start\"), pmt.PMT_NIL)\n        end = pmt.dict_ref(times,\
      \ pmt.intern(\"phy_end\"), pmt.PMT_NIL)\n        if not pmt.is_uint64(start)\
      \ or not pmt.is_uint64(end):\n            return\n        frame_id = pmt.symbol_to_string(frame_id)\n\
      \        start, end = pmt.to_uint64(start), pmt.to_uint64(end)\n        if event\
      \ == \"frame_start\":\n            self.starts[frame_id] = start\n         \
      \   return\n        first = self.starts.pop(frame_id, None)\n        if first\
      \ is None or end < start or end < first:\n            return\n        elapsed_ms\
      \ = (end - first) / 1e6\n        tail_ms = (end - start) / 1e6\n        self.count\
      \ += 1\n        self.total_ms += elapsed_ms\n        print(f\"[PHY latency estimate]\
      \ {frame_id}: \"\n              f\"start-to-completion={elapsed_ms:.4f} ms,\
      \ \"\n              f\"end-to-completion={tail_ms:.4f} ms, \"\n            \
      \  f\"mean={self.total_ms / self.count:.4f} ms (n={self.count})\",\n       \
      \       flush=True)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('PHY latency', 'blk', [], [('latency', 'message', 1)], [], 'Print
      host-side PHY chunk-completion latency for annotated frames.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 384.0]
    rotation: 0
    state: enabled
