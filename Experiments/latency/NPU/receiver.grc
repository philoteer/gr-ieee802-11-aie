- name: epy_block_0_0
  id: epy_block
  parameters:
    VECTOR_SIZE: '4096'
    _source_code: "#!/usr/bin/env python\n# -*- coding: utf-8 -*-\n#\n# Copyright\
      \ 2026 gr-mlir_aie author.\n#\n# SPDX-License-Identifier: GPL-3.0-or-later\n\
      #\n\n\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\n\nimport aie.iron\
      \ as iron\nfrom aie.utils import DefaultNPURuntime, NPUKernel\nimport os\nimport\
      \ tempfile\n\n\nINPUT_DTYPE = np.int32\nOUTPUT_DTYPE = np.int8\nMETADATA_DTYPE\
      \ = np.int32\n\nMAX_TAGS_PER_TILE = 16\nN_TILES = 4\nCSI_SIZE = 64\nQ16_15_SCALE\
      \ = 1.0 / (1 << 15)\n\n# These aligned dtypes reproduce tag_metadata and tile_metadata\
      \ from the C++\n# block, including the uint64 fields and the CSI complex pairs.\n\
      CSI_DTYPE = np.dtype([\n    (\"real\", np.int32),\n    (\"imag\", np.int32),\n\
      ], align=True)\nTAG_METADATA_DTYPE = np.dtype([\n    (\"offset\", np.int32),\n\
      \    (\"frame_start\", np.uint32),\n    (\"frame_bytes\", np.uint64),\n    (\"\
      encoding\", np.uint64),\n    (\"snr_linear\", np.uint64),\n    (\"center_frequency_mhz\"\
      , np.uint32),\n    (\"frequency_offset\", np.int32),\n    (\"beta\", np.int32),\n\
      \    (\"csi\", CSI_DTYPE, (CSI_SIZE,)),\n], align=True)\nTILE_METADATA_DTYPE\
      \ = np.dtype([\n    (\"output_length\", np.int32),\n    (\"tag_count\", np.int32),\n\
      \    (\"tags\", TAG_METADATA_DTYPE, (MAX_TAGS_PER_TILE,)),\n], align=True)\n\
      METADATA_WORDS = N_TILES * TILE_METADATA_DTYPE.itemsize // np.dtype(\n    METADATA_DTYPE).itemsize\n\
      \n\nclass mlir_aie_python_80211_phy(gr.basic_block):\n    \"\"\"Run the MLIR-AIE\
      \ 802.11 PHY and recreate frame equalizer tags.\"\"\"\n\n    def __init__(self,\n\
      \                 path_xclbin=\"kernel/build/final.xclbin\",\n             \
      \    path_insts_bin=\"kernel/build/insts.bin\",\n                 kernel_name=\"\
      MLIR_AIE\",\n                 VECTOR_SIZE=4096,\n                 nominal_frequency=2.417e9):\n\
      \        gr.basic_block.__init__(\n            self,\n            name=\"mlir_aie_python_80211_phy\"\
      ,\n            in_sig=[INPUT_DTYPE],\n            out_sig=[OUTPUT_DTYPE],\n\
      \        )\n\n        center_frequency_mhz = round(nominal_frequency / 1e6)\n\
      \        instructions = np.fromfile(path_insts_bin, dtype=np.uint32).copy()\n\
      \        for marker, value in ((0x13579BDF, center_frequency_mhz), (0x2468ACE0,\
      \ round(20.0 / center_frequency_mhz * (1 << 30)))):\n            matches = np.flatnonzero(instructions\
      \ == marker)\n            if len(matches) != 1:\n                raise RuntimeError(\"\
      center-frequency RTP marker is missing or ambiguous\")\n            instructions[matches[0]]\
      \ = np.uint32(value)\n        self.rtp_dir = tempfile.TemporaryDirectory()\n\
      \        patched_insts = os.path.join(self.rtp_dir.name, \"insts.bin\")\n  \
      \      instructions.tofile(patched_insts)\n\n        npu_kernel = NPUKernel(\n\
      \            path_xclbin,\n            patched_insts,\n            kernel_name=kernel_name,\n\
      \        )\n        self.kernel_handle = DefaultNPURuntime.load(npu_kernel)\n\
      \        self.out_buf = iron.zeros(VECTOR_SIZE, dtype=OUTPUT_DTYPE)\n      \
      \  self.out_meta_buf = iron.zeros(METADATA_WORDS, dtype=METADATA_DTYPE)\n  \
      \      self.VECTOR_SIZE = VECTOR_SIZE\n        self.TILE_SIZE = VECTOR_SIZE\
      \ // N_TILES\n        self.nominal_frequency = nominal_frequency\n\n       \
      \ self.set_tag_propagation_policy(gr.TPP_DONT)\n        self.tag_srcid = pmt.intern(\"\
      frame_equalizer\")\n        self.tag_keys = {\n            \"frame_bytes\":\
      \ pmt.intern(\"frame bytes\"),\n            \"encoding\": pmt.intern(\"encoding\"\
      ),\n            \"snr\": pmt.intern(\"snr\"),\n            \"nominal_frequency\"\
      : pmt.intern(\"nominal frequency\"),\n            \"frequency_offset\": pmt.intern(\"\
      frequency offset\"),\n            \"beta\": pmt.intern(\"beta\"),\n        \
      \    \"csi\": pmt.intern(\"csi\"),\n        }\n\n    def forecast(self, noutput_items,\
      \ ninputs):\n        return [noutput_items] * ninputs\n\n    def set_nominal_frequency(self,\
      \ nominal_frequency):\n        self.nominal_frequency = nominal_frequency\n\n\
      \    def general_work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out0 = output_items[0]\n        n_chunks = min(len(in0), len(out0))\
      \ // self.VECTOR_SIZE\n\n        if n_chunks == 0:\n            return 0\n\n\
      \        output_abs_start = self.nitems_written(0)\n        total_produced =\
      \ 0\n\n        for chunk_idx in range(n_chunks):\n            input_start =\
      \ chunk_idx * self.VECTOR_SIZE\n            input_end = input_start + self.VECTOR_SIZE\n\
      \            current_in_tensor = iron.tensor(\n                in0[input_start:input_end],\
      \ dtype=INPUT_DTYPE)\n\n            DefaultNPURuntime.run(\n               \
      \ self.kernel_handle,\n                [current_in_tensor, self.out_buf, self.out_meta_buf],\n\
      \            )\n\n            npu_output = self.out_buf.numpy()\n          \
      \  metadata = self.out_meta_buf.numpy().view(\n                TILE_METADATA_DTYPE).reshape(N_TILES)\n\
      \n            for tile_idx, tile_meta in enumerate(metadata):\n            \
      \    tile_len = max(\n                    0, min(int(tile_meta[\"output_length\"\
      ]), self.TILE_SIZE))\n                tile_start = tile_idx * self.TILE_SIZE\n\
      \                out0[total_produced:total_produced + tile_len] = npu_output[\n\
      \                    tile_start:tile_start + tile_len]\n\n                tile_abs_start\
      \ = output_abs_start + total_produced\n                tag_count = max(\n  \
      \                  0, min(int(tile_meta[\"tag_count\"]), MAX_TAGS_PER_TILE))\n\
      \                for tag in tile_meta[\"tags\"][:tag_count]:\n             \
      \       tag_offset = int(tag[\"offset\"])\n                    if 0 <= tag_offset\
      \ < tile_len:\n                        self._add_frame_tags(tile_abs_start +\
      \ tag_offset, tag)\n\n                total_produced += tile_len\n\n       \
      \ self.consume_each(n_chunks * self.VECTOR_SIZE)\n        return total_produced\n\
      \n    def _add_frame_tags(self, offset, tag):\n        csi = np.empty(CSI_SIZE,\
      \ dtype=np.complex64)\n        csi.real = tag[\"csi\"][\"real\"] * Q16_15_SCALE\n\
      \        csi.imag = tag[\"csi\"][\"imag\"] * Q16_15_SCALE\n\n        values\
      \ = {\n            \"frame_bytes\": pmt.from_uint64(int(tag[\"frame_bytes\"\
      ])),\n            \"encoding\": pmt.from_uint64(int(tag[\"encoding\"])),\n \
      \           \"snr\": pmt.from_double(10.0 * np.log10(int(tag[\"snr_linear\"\
      ]) / 32.0)),\n            \"nominal_frequency\": pmt.from_double(int(tag[\"\
      center_frequency_mhz\"]) * 1e6),\n            \"frequency_offset\": pmt.from_double(\n\
      \                int(tag[\"frequency_offset\"]) / (1 << 29) * 20e6 / (2.0 *\
      \ np.pi)),\n            \"beta\": pmt.from_double(int(tag[\"beta\"]) / (1 <<\
      \ 29)),\n            \"csi\": pmt.init_c32vector(52, csi[:52].tolist()),\n \
      \       }\n        for name, value in values.items():\n            self.add_item_tag(\n\
      \                0, offset, self.tag_keys[name], value, self.tag_srcid)\n"
    affinity: ''
    alias: ''
    comment: ''
    kernel_name: '"MLIR_AIE"'
    maxoutbuf: '0'
    minoutbuf: '0'
    nominal_frequency: freq
    path_insts_bin: '"kernel/build/insts.bin"'
    path_xclbin: '"kernel/build/final.xclbin"'
  states:
    _io_cache: ('mlir_aie_python_80211_phy', 'mlir_aie_python_80211_phy', [('path_xclbin',
      "'kernel/build/final.xclbin'"), ('path_insts_bin', "'kernel/build/insts.bin'"),
      ('kernel_name', "'MLIR_AIE'"), ('VECTOR_SIZE', '4096'), ('nominal_frequency',
      '2417000000.0')], [('0', 'int', 1)], [('0', 'byte', 1)], 'Run the MLIR-AIE 802.11
      PHY and recreate frame equalizer tags.', ['VECTOR_SIZE', 'nominal_frequency'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 288.0]
    rotation: 0
    state: disabled
