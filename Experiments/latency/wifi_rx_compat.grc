options:
  parameters:
    catch_exceptions: 'False'
    category: Custom
    description: Verify one SigMF fixture through both CPU receivers and the baseline LS NPU
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: wifi_rx_compat
    output_language: python
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    title: Wi-Fi receiver compatibility check
  states:
    coordinate: [8, 8]
    state: enabled
