    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: capture_base + ".sigmf-data"
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 216]
    rotation: 0
    state: enabled
