options:
  parameters:
    author: ''
    catch_exceptions: 'False'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Verify one SigMF fixture through both CPU receivers and the baseline
      LS NPU
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: wifi_rx_compat
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Wi-Fi receiver compatibility check
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: capture_meta
  id: variable
  parameters:
    comment: ''
    value: __import__('json').loads(__import__('pathlib').Path(capture_base + '.sigmf-meta').read_text())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 8]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: capture_meta['captures'][0]['core:frequency']
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 88]
    rotation: 0
    state: enabled
- name: llr_count
  id: variable
  parameters:
    comment: BPSK 1/2 soft bits; native mux appends lookahead for finite-file decoding.
    value: sum(((16 + 8 * __import__('json').loads(a['core:comment'])['psdu_bytes']
      + 6 + 23) // 24) * 48 for a in capture_meta['annotations'])
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 88]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
