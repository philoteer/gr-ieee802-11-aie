- name: prepare_check
  id: snippet
  parameters:
    alias: ''
    code: "import hashlib\nimport json\nfrom pathlib import Path\nimport numpy as\
      \ np\nif self.capture_meta['global']['core:sample_rate'] != 20000000:\n    raise\
      \ ValueError('Compatibility check requires 20 MHz I/Q')\ndata = Path(self.capture_base\
      \ + '.sigmf-data').read_bytes()\nif hashlib.sha512(data).hexdigest() != self.capture_meta['global']['core:sha512']:\n\
      \    raise ValueError('SigMF checksum mismatch')\nsamples = np.frombuffer(data,\
      \ dtype='<c8')\nself.peak = float(max(np.max(np.abs(samples.real)), np.max(np.abs(samples.imag))))\n\
      if not np.isfinite(samples).all() or self.peak >= 1:\n    raise ValueError('Input\
      \ does not fit unclipped Q15')\nself.expected = [json.loads(a['core:comment'])\
      \ for a in self.capture_meta['annotations']]\nif not self.expected:\n    raise\
      \ ValueError('No expected frames')\nself.receivers = {'gr-ieee802-11': self.legacy_pdus,\
      \ 'gr-ieee80211': self.grwifi_pdus, 'NPU-base-LS': self.npu_pdus}\n"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 8]
    rotation: 0
    state: enabled
