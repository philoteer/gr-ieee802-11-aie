- name: capture_base
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Capture basename
    short_id: ''
    type: str
    value: '"wifi_latency"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: check_payloads
  id: snippet
  parameters:
    alias: ''
    code: "import hashlib\nimport json\nfrom pathlib import Path\nimport zlib\nframes,\
      \ errors = {}, []\nfor name, store in self.receivers.items():\n    frames[name]\
      \ = []\n    for i in range(store.num_messages()):\n        try:\n          \
      \  mac = bytes(pmt.to_python(pmt.cdr(store.get_message(i))))\n            if\
      \ name == 'gr-ieee80211':\n                length = int.from_bytes(mac[1:3],\
      \ 'little')\n                if len(mac) != length + 4 or zlib.crc32(mac[3:3\
      \ + length]) != 0x2144df1c:\n                    raise ValueError('Invalid GR-WiFi\
      \ envelope/FCS')\n                mac = mac[3:3 + length - 4]\n            expected\
      \ = self.expected[i]\n            if mac[24:] != expected['payload_ascii'].encode('ascii')\
      \ or int.from_bytes(mac[22:24], 'little') >> 4 != expected['mac_sequence_number']:\n\
      \                raise ValueError('Payload or MAC sequence mismatch')\n    \
      \        frames[name].append(expected['frame_id'])\n        except Exception\
      \ as error:\n            errors.append('%s frame %d: %s' % (name, i, error))\n\
      \    if len(frames[name]) != len(self.expected):\n        errors.append('%s:\
      \ %d/%d matching frames' % (name, len(frames[name]), len(self.expected)))\n\
      report = {'sample_rate': 20000000, 'frequency': self.freq, 'expected_frames':\
      \ len(self.expected),\n    'decoded_frame_ids': frames, 'peak_iq_component':\
      \ self.peak, 'errors': errors, 'passed': not errors,\n    'capture_sha512':\
      \ self.capture_meta['global']['core:sha512'],\n    'npu_configuration': 'base\
      \ LS, 16384 samples/batch, 16 tiles, 2 slots',\n    'npu_xclbin_sha256': hashlib.sha256((Path(self.kernel_dir)\
      \ / 'final.xclbin').read_bytes()).hexdigest(),\n    'npu_insts_sha256': hashlib.sha256((Path(self.kernel_dir)\
      \ / 'insts.bin').read_bytes()).hexdigest()}\nPath('compat_report.json').write_text(json.dumps(report,\
      \ indent=2) + '\\n')\nif errors:\n    raise RuntimeError('; '.join(errors))\n\
      for name in frames:\n    print('PASS %s: %d/%d CRC-checked payloads' % (name,\
      \ len(frames[name]), len(self.expected)))\n"
    comment: ''
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 8]
    rotation: 0
    state: enabled
- name: finish_check
  id: snippet
  parameters:
    alias: ''
    code: "import time\ndeadline = time.monotonic() + 60\ntry:\n    while min(b.num_messages()\
      \ for b in self.receivers.values()) < len(self.expected):\n        if time.monotonic()\
      \ > deadline:\n            break\n        time.sleep(0.01)\nfinally:\n    self.stop()\n\
      \    self.wait()\n"
    comment: ''
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 8]
    rotation: 0
    state: enabled
