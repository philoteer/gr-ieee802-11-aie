options:
  parameters:
    author: ''
    catch_exceptions: 'False'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Native-block 20 MHz Wi-Fi fixture with sample-exact SigMF annotations
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: wifi_tx_sigmf
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Wi-Fi latency SigMF generator
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: body_samples
  id: variable
  parameters:
    comment: ''
    value: (frame_count - 1) * frame_spacing + frame_samples
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 168]
    rotation: 0
    state: enabled
- name: first_sample
  id: variable
  parameters:
    comment: ''
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 8]
    rotation: 0
    state: enabled
- name: frame_count
  id: variable
  parameters:
    comment: ''
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 8]
    rotation: 0
    state: enabled
- name: frame_samples
  id: variable
  parameters:
    comment: BPSK 1/2, MAC+FCS=28 bytes, five preamble/SIGNAL symbols, rolloff=2.
    value: 80 * (5 + (16 + 8 * (pdu_length + 28) + 6 + 23) // 24) + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 168]
    rotation: 0
    state: enabled
- name: frame_spacing
  id: variable
  parameters:
    comment: ''
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 8]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: ''
    value: '2412000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 8]
    rotation: 0
    state: enabled
- name: noise_seed
  id: variable
  parameters:
    comment: Native Noise Source uses seed 0 for system time; use a positive seed.
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 88]
    rotation: 0
    state: enabled
- name: noise_std
  id: variable
  parameters:
    comment: ''
    value: '0.003'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 88]
    rotation: 0
    state: enabled
- name: output_base
  id: variable
  parameters:
    comment: ''
    value: '"wifi_latency"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 88]
    rotation: 0
    state: enabled
- name: payloads
  id: variable
  parameters:
    comment: ''
    value: '[(''WIFI-LATENCY:%08d:'' % i).ljust(pdu_length, ''x'') for i in range(frame_count)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 168]
    rotation: 0
    state: enabled
- name: pdu_length
  id: variable
  parameters:
    comment: ''
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 88]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '20000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: tail_samples
  id: variable
  parameters:
    comment: ''
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 8]
    rotation: 0
    state: enabled
- name: total_samples
  id: variable
  parameters:
    comment: ''
    value: first_sample + body_samples + tail_samples
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 168]
    rotation: 0
    state: enabled
- name: tx_scale
  id: variable
  parameters:
    comment: ''
    value: '0.2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 88]
    rotation: 0
    state: enabled
- name: add_noise
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 536]
    rotation: 0
    state: enabled
- name: await_capture
  id: snippet
  parameters:
    alias: ''
    code: "import time\ndeadline = time.monotonic() + 60\ntry:\n    while (min(self.iq_file.nitems_read(0),\
      \ self.output_tags.nitems_read(0)) < self.total_samples\n           or self.phy_tags.num_tags()\
      \ < self.frame_count):\n        if time.monotonic() > deadline:\n          \
      \  raise RuntimeError(\"Timed out waiting for native capture blocks\")\n   \
      \     time.sleep(0.01)\nfinally:\n    self.stop()\n    self.wait()"
    comment: ''
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 816]
    rotation: 0
    state: enabled
- name: background_noise
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_std * 2**0.5
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: noise_seed
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 656]
    rotation: 0
    state: enabled
- name: capture_length
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: total_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [976, 536]
    rotation: 0
    state: enabled
- name: epy_block_metadata
  id: epy_block
  parameters:
    _source_code: "import hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\
      import pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    \"\"\
      \"Metadata only: no streaming ports or Python work callback.\"\"\"\n\n    def\
      \ __init__(self):\n        gr.basic_block.__init__(self, name=\"SigMF metadata\"\
      , in_sig=None, out_sig=None)\n\n    def prepare(self, g):\n        if not (sys.byteorder\
      \ == \"little\" and g.frame_count > 0 and\n                32 <= g.pdu_length\
      \ <= 1500 and g.first_sample >= 0 and\n                g.tail_samples >= 0 and\
      \ g.frame_spacing >= g.frame_samples and\n                g.samp_rate > 0 and\
      \ g.noise_seed > 0 and g.noise_std >= 0 and g.tx_scale > 0):\n            raise\
      \ ValueError(\"Invalid capture parameters or non-little-endian host\")\n   \
      \     Path(g.output_base + \".sigmf-meta\").unlink(missing_ok=True)\n      \
      \  g.phy_tags.set_save_all(True)\n        g.output_tags.set_save_all(True)\n\
      \n    def write(self, g):\n        g.iq_file.close()  # Native File Sink flushes\
      \ before hashing.\n        path = Path(g.output_base + \".sigmf-data\")\n  \
      \      bursts, placed = g.phy_tags.current_tags(), g.output_tags.current_tags()\n\
      \        if path.stat().st_size != g.total_samples * 8 or len(bursts) != g.frame_count\
      \ or len(placed) != g.frame_count:\n            raise RuntimeError(\"Incomplete\
      \ capture or frame tag count mismatch\")\n        annotations = []\n       \
      \ for i, (burst, tag) in enumerate(zip(bursts, placed)):\n            start,\
      \ length = int(tag.offset), int(pmt.to_long(burst.value))\n            if length\
      \ != g.frame_samples or burst.offset != i * length or start != g.first_sample\
      \ + i * g.frame_spacing:\n                raise RuntimeError(\"Native PHY length\
      \ or scheduled offset mismatch\")\n            annotations.append({\"core:sample_start\"\
      : start, \"core:sample_count\": length,\n                \"core:label\": \"\
      wifi-frame-%08d\" % i, \"core:comment\": json.dumps({\n                    \"\
      frame_id\": i, \"payload_ascii\": g.payloads[i], \"payload_bytes\": g.pdu_length,\n\
      \                    \"psdu_bytes\": g.pdu_length + 28, \"encoding\": \"BPSK\
      \ 1/2\",\n                    \"mac_sequence_number\": i % 4096, \"start_seconds\"\
      : start / g.samp_rate,\n                    \"end_seconds\": (start + length)\
      \ / g.samp_rate})})\n        with path.open(\"rb\") as data:\n            checksum\
      \ = hashlib.file_digest(data, \"sha512\").hexdigest()\n        metadata = {\"\
      global\": {\"core:datatype\": \"cf32_le\", \"core:sample_rate\": g.samp_rate,\n\
      \            \"core:num_channels\": 1, \"core:version\": \"1.2.0\", \"core:sha512\"\
      : checksum,\n            \"core:recorder\": \"wifi_tx_sigmf.grc (native GNU\
      \ Radio blocks)\",\n            \"core:description\": \"BPSK 1/2; tx_scale=%g;\
      \ native Gaussian noise std=%g per I/Q, seed=%d; no CFO or multipath. Annotations\
      \ include PHY windowing tail.\" %\n                (g.tx_scale, g.noise_std,\
      \ g.noise_seed)},\n            \"captures\": [{\"core:sample_start\": 0, \"\
      core:frequency\": g.freq}], \"annotations\": annotations}\n        Path(g.output_base\
      \ + \".sigmf-meta\").write_text(json.dumps(metadata, indent=2) + \"\\n\")\n\
      \        print(\"Wrote %d frames, %d complex samples to %s\" % (g.frame_count,\
      \ g.total_samples, path))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''SigMF metadata'', ''blk'', [], [], [], ''Metadata only: no streaming
      ports or Python work callback.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 816]
    rotation: 0
    state: enabled
- name: finish_metadata
  id: snippet
  parameters:
    alias: ''
    code: self.epy_block_metadata.write(self)
    comment: ''
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 816]
    rotation: 0
    state: enabled
