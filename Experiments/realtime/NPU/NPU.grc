- name: epy_block_0_0
  id: epy_block
  parameters:
    VECTOR_SIZE: '4096'
    _source_code: "#!/usr/bin/env python\n# -*- coding: utf-8 -*-\n#\n# Copyright\
      \ 2026 gr-mlir_aie author.\n#\n# SPDX-License-Identifier: GPL-3.0-or-later\n\
      #\n\n\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\n\nimport aie.iron\
      \ as iron\nfrom aie.utils import DefaultNPURuntime, NPUKernel\nimport os\nimport\
      \ tempfile\n\n\nINPUT_DTYPE = np.int32\nOUTPUT_DTYPE = np.int8\nMETADATA_DTYPE\
      \ = np.int32\n\nMAX_TAGS_PER_TILE = 16\nN_TILES = 4\nCSI_SIZE = 64\nQ16_15_SCALE\
      \ = 1.0 / (1 << 15)\n\n# These aligned dtypes reproduce tag_metadata and tile_metadata\
      \ from the C++\n# block, including the uint64 fields and the CSI complex pairs.\n\
      CSI_DTYPE = np.dtype([\n    (\"real\", np.int32),\n    (\"imag\", np.int32),\n\
      ], align=True)\nTAG_METADATA_DTYPE = np.dtype([\n    (\"offset\", np.int32),\n\
      \    (\"frame_start\", np.uint32),\n    (\"frame_bytes\", np.uint64),\n    (\"\
      encoding\", np.uint64),\n    (\"snr_linear\", np.uint64),\n    (\"center_frequency_mhz\"\
      , np.uint32),\n    (\"frequency_offset\", np.int32),\n    (\"beta\", np.int32),\n\
      \    (\"csi\", CSI_DTYPE, (CSI_SIZE,)),\n], align=True)\nTILE_METADATA_DTYPE\
      \ = np.dtype([\n    (\"output_length\", np.int32),\n    (\"tag_count\", np.int32),\n\
      \    (\"tags\", TAG_METADATA_DTYPE, (MAX_TAGS_PER_TILE,)),\n], align=True)\n\
      METADATA_WORDS = N_TILES * TILE_METADATA_DTYPE.itemsize // np.dtype(\n    METADATA_DTYPE).itemsize\n\
      \n\nclass mlir_aie_python_80211_phy(gr.basic_block):\n    \"\"\"Run the MLIR-AIE\
      \ 802.11 PHY and recreate frame equalizer tags.\"\"\"\n\n    def __init__(self,\n\
      \                 path_xclbin=\"kernel/build/final.xclbin\",\n             \
      \    path_insts_bin=\"kernel/build/insts.bin\",\n                 kernel_name=\"\
      MLIR_AIE\",\n                 VECTOR_SIZE=4096,\n                 nominal_frequency=2.417e9):\n\
      \        gr.basic_block.__init__(\n            self,\n            name=\"mlir_aie_python_80211_phy\"\
      ,\n            in_sig=[INPUT_DTYPE],\n            out_sig=[OUTPUT_DTYPE],\n\
      \        )\n\n        center_frequency_mhz = round(nominal_frequency / 1e6)\n\
      \        instructions = np.fromfile(path_insts_bin, dtype=np.uint32).copy()\n\
      \        for marker, value in ((0x13579BDF, center_frequency_mhz), (0x2468ACE0,\
      \ round(20.0 / center_frequency_mhz * (1 << 30)))):\n            matches = np.flatnonzero(instructions\
      \ == marker)\n            if len(matches) != 1:\n                raise RuntimeError(\"\
      center-frequency RTP marker is missing or ambiguous\")\n            instructions[matches[0]]\
      \ = np.uint32(value)\n        self.rtp_dir = tempfile.TemporaryDirectory()\n\
      \        patched_insts = os.path.join(self.rtp_dir.name, \"insts.bin\")\n  \
      \      instructions.tofile(patched_insts)\n\n        npu_kernel = NPUKernel(\n\
      \            path_xclbin,\n            patched_insts,\n            kernel_name=kernel_name,\n\
      \        )\n        self.kernel_handle = DefaultNPURuntime.load(npu_kernel)\n\
      \        self.out_buf = iron.zeros(VECTOR_SIZE, dtype=OUTPUT_DTYPE)\n      \
      \  self.out_meta_buf = iron.zeros(METADATA_WORDS, dtype=METADATA_DTYPE)\n  \
      \      self.VECTOR_SIZE = VECTOR_SIZE\n        self.TILE_SIZE = VECTOR_SIZE\
      \ // N_TILES\n        self.nominal_frequency = nominal_frequency\n\n       \
      \ self.set_tag_propagation_policy(gr.TPP_DONT)\n        self.tag_srcid = pmt.intern(\"\
      frame_equalizer\")\n        self.tag_keys = {\n            \"frame_bytes\":\
      \ pmt.intern(\"frame bytes\"),\n            \"encoding\": pmt.intern(\"encoding\"\
      ),\n            \"snr\": pmt.intern(\"snr\"),\n            \"nominal_frequency\"\
      : pmt.intern(\"nominal frequency\"),\n            \"frequency_offset\": pmt.intern(\"\
      frequency offset\"),\n            \"beta\": pmt.intern(\"beta\"),\n        \
      \    \"csi\": pmt.intern(\"csi\"),\n        }\n\n    def forecast(self, noutput_items,\
      \ ninputs):\n        return [noutput_items] * ninputs\n\n    def set_nominal_frequency(self,\
      \ nominal_frequency):\n        self.nominal_frequency = nominal_frequency\n\n\
      \    def general_work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out0 = output_items[0]\n        n_chunks = min(len(in0), len(out0))\
      \ // self.VECTOR_SIZE\n\n        if n_chunks == 0:\n            return 0\n\n\
      \        output_abs_start = self.nitems_written(0)\n        total_produced =\
      \ 0\n\n        for chunk_idx in range(n_chunks):\n            input_start =\
      \ chunk_idx * self.VECTOR_SIZE\n            input_end = input_start + self.VECTOR_SIZE\n\
      \            current_in_tensor = iron.tensor(\n                in0[input_start:input_end],\
      \ dtype=INPUT_DTYPE)\n\n            DefaultNPURuntime.run(\n               \
      \ self.kernel_handle,\n                [current_in_tensor, self.out_buf, self.out_meta_buf],\n\
      \            )\n\n            npu_output = self.out_buf.numpy()\n          \
      \  metadata = self.out_meta_buf.numpy().view(\n                TILE_METADATA_DTYPE).reshape(N_TILES)\n\
      \n            for tile_idx, tile_meta in enumerate(metadata):\n            \
      \    tile_len = max(\n                    0, min(int(tile_meta[\"output_length\"\
      ]), self.TILE_SIZE))\n                tile_start = tile_idx * self.TILE_SIZE\n\
      \                out0[total_produced:total_produced + tile_len] = npu_output[\n\
      \                    tile_start:tile_start + tile_len]\n\n                tile_abs_start\
      \ = output_abs_start + total_produced\n                tag_count = max(\n  \
      \                  0, min(int(tile_meta[\"tag_count\"]), MAX_TAGS_PER_TILE))\n\
      \                for tag in tile_meta[\"tags\"][:tag_count]:\n             \
      \       tag_offset = int(tag[\"offset\"])\n                    if 0 <= tag_offset\
      \ < tile_len:\n                        self._add_frame_tags(tile_abs_start +\
      \ tag_offset, tag)\n\n                total_produced += tile_len\n\n       \
      \ self.consume_each(n_chunks * self.VECTOR_SIZE)\n        return total_produced\n\
      \n    def _add_frame_tags(self, offset, tag):\n        csi = np.empty(CSI_SIZE,\
      \ dtype=np.complex64)\n        csi.real = tag[\"csi\"][\"real\"] * Q16_15_SCALE\n\
      \        csi.imag = tag[\"csi\"][\"imag\"] * Q16_15_SCALE\n\n        values\
      \ = {\n            \"frame_bytes\": pmt.from_uint64(int(tag[\"frame_bytes\"\
      ])),\n            \"encoding\": pmt.from_uint64(int(tag[\"encoding\"])),\n \
      \           \"snr\": pmt.from_double(10.0 * np.log10(int(tag[\"snr_linear\"\
      ]) / 32.0)),\n            \"nominal_frequency\": pmt.from_double(int(tag[\"\
      center_frequency_mhz\"]) * 1e6),\n            \"frequency_offset\": pmt.from_double(\n\
      \                int(tag[\"frequency_offset\"]) / (1 << 29) * 20e6 / (2.0 *\
      \ np.pi)),\n            \"beta\": pmt.from_double(int(tag[\"beta\"]) / (1 <<\
      \ 29)),\n            \"csi\": pmt.init_c32vector(52, csi[:52].tolist()),\n \
      \       }\n        for name, value in values.items():\n            self.add_item_tag(\n\
      \                0, offset, self.tag_keys[name], value, self.tag_srcid)\n"
    affinity: ''
    alias: ''
    comment: ''
    kernel_name: '"MLIR_AIE"'
    maxoutbuf: '0'
    minoutbuf: '0'
    nominal_frequency: freq
    path_insts_bin: kernel_dir + "/insts.bin"
    path_xclbin: kernel_dir + "/final.xclbin"
  states:
    _io_cache: ('mlir_aie_python_80211_phy', 'mlir_aie_python_80211_phy', [('path_xclbin',
      "'kernel/build/final.xclbin'"), ('path_insts_bin', "'kernel/build/insts.bin'"),
      ('kernel_name', "'MLIR_AIE'"), ('VECTOR_SIZE', '4096'), ('nominal_frequency',
      '2417000000.0')], [('0', 'int', 1)], [('0', 'byte', 1)], 'Run the MLIR-AIE 802.11
      PHY and recreate frame equalizer tags.', ['VECTOR_SIZE', 'nominal_frequency'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 288.0]
    rotation: 0
    state: disabled
- name: epy_block_energy_logger
  id: epy_block
  parameters:
    _source_code: "import atexit\nimport csv\nfrom pathlib import Path\nimport threading\n\
      import time\n\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n   \
      \ \"\"\"Log energy using low-rate polling, without any streaming ports.\n\n\
      \    Lifecycle snippets prepare the baseline before streaming, start the sampler\n\
      \    after native counters are initialized, and finalize after top_block.wait().\n\
      \    No Python work callback or extra IQ buffer reader is scheduled.\n\n   \
      \ Attributes:\n        csv_path (Path): CSV destination, overwritten at each\
      \ start.\n        interval (float): Requested delay between sensor readings\
      \ in seconds.\n        rapl (Path): RAPL package domain directory.\n       \
      \ supplies (Path): ACPI power supply directory.\n        samples (int): Number\
      \ of complex IQ samples last polled from the native counter.\n    \"\"\"\n\n\
      \    def __init__(self, csv_path=\"original_energy.csv\", interval=0.5,\n  \
      \               rapl_path=\"/sys/class/powercap/intel-rapl:0\",\n          \
      \       power_supply_path=\"/sys/class/power_supply\"):\n        \"\"\"Initialize\
      \ the monitor without opening sensors or starting a thread.\n\n        Args:\n\
      \            csv_path (str): Destination path for the measurement CSV.\n   \
      \         interval (float): Sampling delay in seconds, at least 0.05.\n    \
      \        rapl_path (str): Directory containing energy_uj, name, and\n      \
      \          max_energy_range_uj for the measured RAPL domain.\n            power_supply_path\
      \ (str): Directory containing the battery and\n                external power\
      \ supply sysfs entries.\n\n        Raises:\n            ValueError: If interval\
      \ is less than 0.05 seconds.\n        \"\"\"\n        gr.basic_block.__init__(self,\
      \ name=\"Run Energy Logger\",\n                               in_sig=None, out_sig=None)\n\
      \        if interval < 0.05:\n            raise ValueError(\"Energy sampling\
      \ interval must be at least 0.05 s\")\n        self.csv_path = Path(csv_path)\n\
      \        self.interval = interval\n        self.rapl = Path(rapl_path)\n   \
      \     self.supplies = Path(power_supply_path)\n        self.samples = 0\n  \
      \      self._counter = lambda: 0\n        self._sensor_files = {}\n        self._last_flush_ns\
      \ = 0\n        self._done = threading.Event()\n        self._thread = None\n\
      \        self._file = None\n        self._error = None\n        self._previous\
      \ = None\n        self._energy_j = 0.0\n\n    def _read(self, path):\n     \
      \   \"\"\"Read a sysfs attribute and remove surrounding whitespace.\n\n    \
      \    Args:\n            path (Path): Attribute file to read.\n\n        Returns:\n\
      \            str: Stripped attribute value.\n\n        Raises:\n           \
      \ OSError: If the attribute cannot be read.\n        \"\"\"\n        stream\
      \ = self._sensor_files.get(path)\n        if stream is None:\n            stream\
      \ = path.open(\"r\")\n            self._sensor_files[path] = stream\n      \
      \  stream.seek(0)\n        return stream.read().strip()\n\n    def _close_sensors(self):\n\
      \        \"\"\"Close cached sysfs files after the sampler thread has stopped.\"\
      \"\"\n        for stream in self._sensor_files.values():\n            stream.close()\n\
      \        self._sensor_files.clear()\n\n    def _battery_reading(self):\n   \
      \     \"\"\"Read battery measurements only while unplugged and discharging.\n\
      \n        Returns:\n            tuple: External power online flag (bool), battery\
      \ status (str),\n            discharge power in watts (float), and stored energy\
      \ in joules\n            (float). The last two values are empty strings when\
      \ plugged in\n            or when the battery is not discharging.\n\n      \
      \  Raises:\n            OSError: If a required power supply attribute cannot\
      \ be read.\n            ValueError: If a numeric attribute cannot be parsed.\n\
      \        \"\"\"\n        # ACPI sysfs is also the source of sensors' BAT0-acpi\
      \ power1.\n        online = any(int(self._read(path / \"online\")) != 0\n  \
      \                   for path in self._external)\n        status = self._read(self._battery\
      \ / \"status\")\n        unplugged = not online and status == \"Discharging\"\
      \n        if not unplugged:\n            return online, status, \"\", \"\"\n\
      \        # power_now is in microwatts; energy_now is in micro-watt-hours.\n\
      \        watts = int(self._read(self._battery / \"power_now\")) / 1e6\n    \
      \    joules = int(self._read(self._battery / \"energy_now\")) * 0.0036\n   \
      \     return online, status, watts, joules\n\n    def _sample(self, phase):\n\
      \        \"\"\"Take one sensor snapshot, update energy totals, and buffer a\
      \ CSV row.\n\n        The first reading establishes the monotonic time and counter\
      \ baseline.\n        Later readings derive interval-average package power and\
      \ cumulative\n        energy. Calls must be serialized between startup, the\
      \ monitor thread,\n        and finalization.\n\n        Args:\n            phase\
      \ (str): Row marker: \"start\", \"sample\", or \"end\".\n\n        Raises:\n\
      \            OSError: If a sensor read or CSV write fails.\n            ValueError:\
      \ If a numeric sensor attribute cannot be parsed.\n        \"\"\"\n        counter\
      \ = int(self._read(self.rapl / \"energy_uj\"))\n        now = time.monotonic_ns()\n\
      \        self.samples = int(self._counter())\n        wall = time.time_ns()\n\
      \        online, status, system_w, battery_j = self._battery_reading()\n   \
      \     power_w = \"\"\n        if self._previous is None:\n            self._start_ns\
      \ = now\n        else:\n            previous_ns, previous_counter = self._previous\n\
      \            delta = counter - previous_counter\n            if delta < 0:\n\
      \                # Correct one counter wrap between consecutive readings.\n\
      \                delta += self._range_uj\n            self._energy_j += delta\
      \ / 1e6\n            # Convert microjoules / nanoseconds to joules / second\
      \ (watts).\n            power_w = delta * 1000.0 / (now - previous_ns)\n   \
      \     self._previous = now, counter\n        self._writer.writerow({\n     \
      \       \"phase\": phase,\n            \"unix_time_ns\": wall,\n           \
      \ \"elapsed_s\": (now - self._start_ns) / 1e9,\n            \"samples_processed\"\
      : self.samples,\n            \"rapl_domain\": self._domain,\n            \"\
      rapl_energy_uj\": counter,\n            \"rapl_max_energy_range_uj\": self._range_uj,\n\
      \            \"soc_energy_j\": self._energy_j,\n            \"soc_power_w\"\
      : power_w,\n            \"ac_online\": int(online),\n            \"battery_status\"\
      : status,\n            \"system_power_w\": system_w,\n            \"battery_energy_j\"\
      : battery_j,\n        })\n        # Flush boundary rows and at most once every\
      \ five seconds during the run.\n        if phase != \"sample\" or now - self._last_flush_ns\
      \ >= 5_000_000_000:\n            self._file.flush()\n            self._last_flush_ns\
      \ = now\n\n    def _prepare_logging(self):\n        \"\"\"Initialize sensors,\
      \ CSV output, and a not-yet-started sampler thread.\n\n        Called by begin_logging()\
      \ before the flowgraph starts. Takes the baseline\n        reading synchronously\
      \ before launching the monitor thread and\n        registers an exit-time cleanup\
      \ fallback.\n\n        Returns:\n            bool: True when initialization\
      \ succeeds.\n\n        Raises:\n            RuntimeError: If there is not exactly\
      \ one battery or no external\n                power supply online indicator\
      \ is available.\n            OSError: If sensor discovery, attribute reads,\
      \ or CSV setup fails.\n            ValueError: If a numeric sensor attribute\
      \ cannot be parsed.\n        \"\"\"\n        self.csv_path = Path(self.csv_path)\n\
      \        self.rapl = Path(self.rapl)\n        self.supplies = Path(self.supplies)\n\
      \        self.samples = 0\n        self._counter = lambda: 0\n        self._last_flush_ns\
      \ = 0\n        self._thread = None\n        self._previous = None\n        self._energy_j\
      \ = 0.0\n        self._error = None\n        self._done.clear()\n        self._range_uj\
      \ = int(self._read(self.rapl / \"max_energy_range_uj\"))\n        self._domain\
      \ = self._read(self.rapl / \"name\")\n        batteries = [p for p in self.supplies.iterdir()\n\
      \                     if (p / \"type\").exists() and self._read(p / \"type\"\
      ) == \"Battery\"]\n        if len(batteries) != 1:\n            raise RuntimeError(\"\
      Energy logger requires exactly one battery\")\n        self._battery = batteries[0]\n\
      \        self._external = [p for p in self.supplies.iterdir()\n            \
      \              if p != self._battery and (p / \"online\").exists()]\n      \
      \  if not self._external:\n            raise RuntimeError(\"No external power\
      \ supply online indicator found\")\n        self.csv_path.parent.mkdir(parents=True,\
      \ exist_ok=True)\n        self._file = self.csv_path.open(\"w\", newline=\"\"\
      )\n        self._writer = csv.DictWriter(self._file, fieldnames=[\n        \
      \    \"phase\", \"unix_time_ns\", \"elapsed_s\", \"samples_processed\",\n  \
      \          \"rapl_domain\", \"rapl_energy_uj\", \"rapl_max_energy_range_uj\"\
      ,\n            \"soc_energy_j\", \"soc_power_w\", \"ac_online\", \"battery_status\"\
      ,\n            \"system_power_w\", \"battery_energy_j\"])\n        self._writer.writeheader()\n\
      \        try:\n            self._sample(\"start\")\n        except Exception:\n\
      \            self._file.close()\n            self._file = None\n           \
      \ raise\n        self._thread = threading.Thread(target=self._monitor, daemon=True)\n\
      \        atexit.register(self.finish_logging)\n        return True\n\n    def\
      \ _monitor(self):\n        \"\"\"Sample periodically until finalization requests\
      \ a stop.\n\n        Waiting on the event lets finalization wake the thread\
      \ immediately.\n        Sensor or write errors are saved and re-raised by finish_logging(),\n\
      \        leaving the CSV without an end marker.\n        \"\"\"\n        while\
      \ not self._done.wait(self.interval):\n            try:\n                self._sample(\"\
      sample\")\n            except Exception as error:\n                self._error\
      \ = error\n                return\n\n    def finish_logging(self):\n       \
      \ \"\"\"Stop monitoring, take the final reading, and close the CSV.\n\n    \
      \    Call after top_block.wait() returns. This method is idempotent after\n\
      \        the CSV closes. The monitor is joined before the final reading to\n\
      \        prevent concurrent writes. Cleanup closes the CSV even on failure.\n\
      \n        Raises:\n            RuntimeError: If background sampling failed.\n\
      \            OSError: If the final sensor read or CSV write fails.\n       \
      \     ValueError: If a final numeric sensor attribute cannot be parsed.\n  \
      \      \"\"\"\n        # The IQ branch can finish before the decoder. Do not\
      \ finalize in\n        # block.stop(): the flowgraph's after-stop snippet calls\
      \ this after wait().\n        if self._file is None:\n            self._close_sensors()\n\
      \            return\n        self._done.set()\n        if self._thread is not\
      \ None and self._thread.ident is not None:\n            self._thread.join()\n\
      \        try:\n            if self._error is not None:\n                raise\
      \ RuntimeError(\"Energy sampling failed\") from self._error\n            self._sample(\"\
      end\")\n        finally:\n            self._file.close()\n            self._file\
      \ = None\n            self._close_sensors()\n            atexit.unregister(self.finish_logging)\n\
      \n    def begin_logging(self):\n        \"\"\"Take the baseline before top_block.start(),\
      \ without starting a thread.\n\n        Raises:\n            RuntimeError: If\
      \ logging is active or sensor discovery fails.\n            OSError: If sensors\
      \ or the CSV cannot be accessed.\n            ValueError: If a numeric sensor\
      \ reading is invalid.\n        \"\"\"\n        if self._file is not None:\n\
      \            raise RuntimeError(\"Energy logging is already active\")\n    \
      \    try:\n            self._prepare_logging()\n        except Exception:\n\
      \            self.finish_logging()\n            raise\n\n    def start_monitoring(self,\
      \ sample_counter):\n        \"\"\"Start sampling after the native source has\
      \ initialized its counters.\n\n        Args:\n            sample_counter (Callable[[],\
      \ int]): Native IQ sample counter, polled\n                once per sensor snapshot\
      \ rather than per streaming buffer.\n\n        Raises:\n            RuntimeError:\
      \ If logging is unprepared or monitoring is already active.\n        \"\"\"\n\
      \        if self._file is None or self._thread.ident is not None:\n        \
      \    raise RuntimeError(\"Prepare logging once before starting monitoring\"\
      )\n        self._counter = sample_counter\n        self._thread.start()\n"
    affinity: ''
    alias: ''
    comment: No stream ports; lifecycle snippets control low-rate native-counter polling.
    csv_path: data_dir + "/tmp_out/npu_energy.csv"
    interval: '0.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    power_supply_path: '"/sys/class/power_supply"'
    rapl_path: '"/sys/class/powercap/intel-rapl:0"'
  states:
    _io_cache: '(''Run Energy Logger'', ''blk'', [(''csv_path'', "''original_energy.csv''"),
      (''interval'', ''0.5''), (''rapl_path'', "''/sys/class/powercap/intel-rapl:0''"),
      (''power_supply_path'', "''/sys/class/power_supply''")], [], [], ''Log energy
      using low-rate polling, without any streaming ports.\n\n    Lifecycle snippets
      prepare the baseline before streaming, start the sampler\n    after native counters
      are initialized, and finalize after top_block.wait().\n    No Python work callback
      or extra IQ buffer reader is scheduled.\n\n    Attributes:\n        csv_path
      (Path): CSV destination, overwritten at each start.\n        interval (float):
      Requested delay between sensor readings in seconds.\n        rapl (Path): RAPL
      package domain directory.\n        supplies (Path): ACPI power supply directory.\n        samples
      (int): Number of complex IQ samples last polled from the native counter.\n    '',
      [''csv_path'', ''interval''])'
