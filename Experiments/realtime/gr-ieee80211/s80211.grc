- name: energy_logger_start
  id: snippet
  parameters:
    section: main_after_start
    priority: '0'
    code: 'self.epy_block_energy_logger.start_monitoring(lambda: self.uhd_usrp_source_0.nitems_written(0))'
  states:
    coordinate: [16, 680]
    rotation: 0
