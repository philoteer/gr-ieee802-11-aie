- name: energy_logger_finish
  id: snippet
  parameters:
    alias: ''
    code: self.epy_block_energy_logger.finish_logging()
    comment: Finish after all processing, on EOF or SIGINT/SIGTERM.
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 132.0]
    rotation: 0
    state: enabled
- name: energy_logger_prepare
  id: snippet
  parameters:
    alias: ''
    code: self.epy_block_energy_logger.begin_logging()
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
