    bus_structure: null
    coordinate: [0, 284.0]
    rotation: 0
    state: enabled
- name: virtual_source_0_0
  id: virtual_source
  parameters:
    alias: ''
    comment: ''
    stream_id: iq
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 32.0]
