    bus_structure: null
    coordinate: [368, 228.0]
    rotation: 0
    state: enabled
- name: mlir_aie_sigmf_tag_injector_0
  id: mlir_aie_sigmf_tag_injector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    metadata_file: file_path+"-meta"
    minoutbuf: '0'
    start_sample: '0'
    tag_key: rx_freq
    type: complex
  states:
