- name: mlir_aie_mlir_aie_80211_phy_0
  id: mlir_aie_mlir_aie_80211_phy
  parameters:
    N_TILES: '16'
    VECTOR_SIZE: '16384'
    affinity: ''
    alias: ''
    comment: ''
    kernel_name: MLIR_AIE
    maxoutbuf: '0'
    minoutbuf: '0'
    nominal_frequency: freq
    num_slots: '2'
    path_insts_bin: /home/piloteer/xdna_phy/gr-ieee802-11-aie/Experiments/xclbin_default/LS/insts.bin
    path_xclbin: /home/piloteer/xdna_phy/gr-ieee802-11-aie/Experiments/xclbin_default/LS/final.xclbin
    weights_path: ''''''
  states:
    bus_sink: false
