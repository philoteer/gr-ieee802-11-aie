- name: zz_candidate_replay
  id: epy_block
  parameters:
    _source_code: "from collections import deque\nfrom pathlib import Path\n\nimport\
      \ numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _require_build(algorithm):\n\
      \    supported = {'ls', 'lms', 'comb', 'sta'}\n    if algorithm not in supported:\n\
      \        raise RuntimeError(\n            f'unknown EQUALIZER_ALGORITHM={algorithm!r};\
      \ choose LS, LMS, COMB, or STA')\n    build = Path('build')\n    marker = build\
      \ / 'frame_equalizer_build_mode.txt'\n    artifacts = [build / 'final.xclbin',\
      \ build / 'insts.bin']\n    missing = [str(path) for path in [marker, *artifacts]\
      \ if not path.is_file()]\n    if missing:\n        raise RuntimeError(\n   \
      \         'missing frame-equalizer build output(s): ' + ', '.join(missing) +\n\
      \            '; run `make compare EQUALIZER_ALGORITHM=' + algorithm.upper()\
      \ + '`')\n    mode = {}\n    for line in marker.read_text().splitlines():\n\
      \        if '=' in line:\n            key, value = line.split('=', 1)\n    \
      \        mode[key.strip()] = value.strip()\n    if mode.get('DFRAME_EQUALIZER_OUTPUT_SYMBOLS')\
      \ != '1':\n        raise RuntimeError(\n            'NPU is not a symbols build\
      \ (DFRAME_EQUALIZER_OUTPUT_SYMBOLS=' +\n            repr(mode.get('DFRAME_EQUALIZER_OUTPUT_SYMBOLS'))\
      \ +\n            '); run `make compare EQUALIZER_ALGORITHM=' + algorithm.upper()\
      \ + '`')\n    if mode.get('EQUALIZER_ALGORITHM', '').lower() != algorithm:\n\
      \        raise RuntimeError(\n            'NPU algorithm is ' + repr(mode.get('EQUALIZER_ALGORITHM',\
      \ 'unknown')) +\n            ', but the flowgraph selected ' + repr(algorithm)\
      \ +\n            '; rebuild through `make compare EQUALIZER_ALGORITHM=' +\n\
      \            algorithm.upper() + '`')\n    if mode.get('ENGINE') not in {'CLASSIC',\
      \ 'AI'}:\n        raise RuntimeError('invalid or missing ENGINE in ' + str(marker))\n\
      \    if marker.stat().st_mtime_ns < max(path.stat().st_mtime_ns for path in\
      \ artifacts):\n        raise RuntimeError(str(marker) + ' is older than the\
      \ NPU artifacts; rebuild')\n    instructions = np.fromfile(artifacts[1], dtype=np.uint32)\n\
      \    for sentinel in (0x13579BDF, 0x2468ACE0):\n        count = int(np.count_nonzero(instructions\
      \ == sentinel))\n        if count != 1:\n            raise RuntimeError(\n \
      \               f'build/insts.bin has {count} copies of RTP marker {sentinel:#x};\
      \ expected 1')\n\n\nclass candidate_replay(gr.basic_block):\n    \"\"\"Emit\
      \ the four 64-bin vectors selected by each aligned wifi_start tag.\"\"\"\n\n\
      \    def __init__(self, algorithm='ls'):\n        gr.basic_block.__init__(\n\
      \            self, name='candidate_replay',\n            in_sig=[(np.complex64,\
      \ 64)], out_sig=[(np.complex64, 64)])\n        self.algorithm = algorithm\n\
      \        self.wifi_key = pmt.intern('wifi_start')\n        # Output offsets\
      \ describe a new candidate-only stream, so input tags must not\n        # propagate\
      \ automatically; work() recreates only quantized wifi_start tags.\n        self.set_tag_propagation_policy(gr.TPP_DONT)\n\
      \        self._buffer = np.empty((0, 64), dtype=np.complex64)\n        self._base\
      \ = 0\n        # _pending holds (vector offset, Q29 CFO) pairs awaiting four\
      \ vectors;\n        # _ready holds complete vectors waiting for scheduler output\
      \ space.\n        self._pending = deque()\n        self._ready = deque()\n \
      \       self.sample_count = 0\n        self.wifi_start_count = 0\n        self.candidate_offsets\
      \ = []\n        if Path('build/frame_equalizer_build_mode.txt').exists():\n\
      \            _require_build(algorithm)\n\n    def start(self):\n        # Check\
      \ again at start so construction before a build cannot bypass the guard.\n \
      \       _require_build(self.algorithm)\n        return True\n\n    def forecast(self,\
      \ noutput_items, ninputs):\n        # Queued vectors can drain without requiring\
      \ another input item.\n        return [0 if self._ready else 1]\n\n    def general_work(self,\
      \ input_items, output_items):\n        in0 = input_items[0]\n        if len(in0):\n\
      \            # Buffer vectors because candidate windows can cross scheduler\
      \ chunks.\n            absolute_start = self.nitems_read(0)\n            if\
      \ self._base + len(self._buffer) != absolute_start:\n                raise RuntimeError('candidate\
      \ replay input is not contiguous')\n            tags = self.get_tags_in_range(\n\
      \                0, absolute_start, absolute_start + len(in0), self.wifi_key)\n\
      \            self._buffer = np.concatenate((self._buffer, np.asarray(in0)))\n\
      \            # Round recorded CFO values exactly as the kernel's Q29 metadata\
      \ ABI does;\n            # stream_to_vector already converted sample offsets\
      \ to vector indices.\n            self._pending.extend(\n                (int(tag.offset),\n\
      \                 round(pmt.to_double(tag.value) * (1 << 29)) / float(1 << 29))\n\
      \                for tag in tags)\n            self.wifi_start_count += len(tags)\n\
      \            self.sample_count = (absolute_start + len(in0)) * 64\n        \
      \    self.consume(0, len(in0))\n\n            available_end = self._base + len(self._buffer)\n\
      \            # A tag becomes runnable only after all four vectors arrive. Incomplete\n\
      \            # tags at EOF are intentionally omitted, matching the procedural\
      \ oracle.\n            while self._pending and self._pending[0][0] + 4 <= available_end:\n\
      \                offset, cfo = self._pending.popleft()\n                self.candidate_offsets.append(offset\
      \ * 64)\n                begin = offset - self._base\n                for index,\
      \ vector in enumerate(self._buffer[begin:begin + 4]):\n                    self._ready.append((vector.copy(),\n\
      \                                         cfo if index == 0 else None))\n  \
      \          # Future tags cannot point into consumed vectors. Keep only the prefix\n\
      \            # needed by the earliest incomplete candidate and discard the rest.\n\
      \            retain_from = self._pending[0][0] if self._pending else available_end\n\
      \            discard = retain_from - self._base\n            if discard:\n \
      \               self._buffer = self._buffer[discard:].copy()\n             \
      \   self._base = retain_from\n\n        count = min(len(output_items[0]), len(self._ready))\n\
      \        # Reattach wifi_start to the first vector only. Standard blocks append\
      \ the\n        # delimiter frames and fixed-size NPU padding downstream.\n \
      \       for index in range(count):\n            vector, cfo = self._ready.popleft()\n\
      \            output_items[0][index] = vector\n            if cfo is not None:\n\
      \                self.add_item_tag(\n                    0, self.nitems_written(0)\
      \ + index, self.wifi_key,\n                    pmt.from_double(cfo), pmt.intern('candidate_replay'))\n\
      \        return count"
    affinity: ''
    algorithm: algorithm
    alias: ''
    comment: '*epy: isolate overlapping recorded candidates and validate the build.'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('candidate_replay', 'candidate_replay', [('algorithm', "'ls'")], [('0',
      'complex', 64)], [('0', 'complex', 64)], 'Emit the four 64-bin vectors selected
      by each aligned wifi_start tag.', ['algorithm'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 528.0]
    rotation: 0
    state: enabled

