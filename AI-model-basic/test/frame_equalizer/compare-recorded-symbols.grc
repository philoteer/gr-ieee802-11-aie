- name: verify
  id: snippet
  parameters:
    alias: ''
    code: "import numpy as np\nimport pmt\n\n# The extractor records source offsets,\
      \ while the two standard transmitter\n# marker payloads delimit the corresponding\
      \ compressed equalizer outputs.\nreplay = self.zz_candidate_replay\nmarker_hard_a\
      \ = np.asarray(self.marker_payload[:48], dtype=np.int8)\nmarker_hard_b = np.asarray(self.marker_payload[48:],\
      \ dtype=np.int8)\n\n# Convert a sink's flat tag list into metadata indexed by\
      \ output-symbol offset.\ndef sink_tags(sink):\n    result = {}\n    for tag\
      \ in sink.tags():\n        offset = int(tag.offset)\n        key = pmt.symbol_to_string(tag.key)\n\
      \        result.setdefault(offset, {})[key] = tag.value\n    return result\n\
      \n# Split the compressed output at each two-marker signature. A four-input-symbol\n\
      # candidate can produce zero or one payload symbol before its delimiter pair.\n\
      def split_candidates(hard, symbols, tags, label):\n    if len(hard) != len(symbols):\n\
      \        raise AssertionError(\n            f'{label} hard/symbol count mismatch:\
      \ {len(hard)} != {len(symbols)}')\n    segments = []\n    pending = []\n   \
      \ for index, (decisions, equalized) in enumerate(zip(hard, symbols)):\n    \
      \    frame_bytes = tags.get(index, {}).get('frame bytes')\n        pending.append((decisions,\
      \ equalized, frame_bytes))\n        is_delimiter = (\n            len(pending)\
      \ >= 2\n            and pending[-2][2] is not None\n            and pmt.to_uint64(pending[-2][2])\
      \ == 0\n            and np.array_equal(pending[-2][0], marker_hard_a)\n    \
      \        and pending[-1][2] is not None\n            and pmt.to_uint64(pending[-1][2])\
      \ == 0\n            and np.array_equal(pending[-1][0], marker_hard_b))\n   \
      \     if is_delimiter:\n            candidate = pending[:-2]\n            if\
      \ len(candidate) > 1:\n                raise AssertionError(\n             \
      \       f'{label} emitted {len(candidate)} candidate symbols before marker '\n\
      \                    f'{len(segments)}; expected at most one')\n           \
      \ segments.append(candidate[0][:2] if candidate else None)\n            pending\
      \ = []\n    if pending:\n        raise AssertionError(f'{label} output ended\
      \ without a marker delimiter')\n    if len(segments) != len(replay.candidate_offsets):\n\
      \        raise AssertionError(\n            f'{label} marker count {len(segments)}\
      \ != replayed candidate count '\n            f'{len(replay.candidate_offsets)}')\n\
      \    return segments\n\n# GNU Radio publishes hard decisions as a stream and\
      \ normalized symbols as PDUs;\n# their order is identical, so zip them before\
      \ delimiter reconstruction.\nreference_hard = np.asarray(\n    self.blocks_reference_decisions_sink.data(),\
      \ dtype=np.int8).reshape(-1, 48)\nreference_debug = self.blocks_reference_symbols_debug\n\
      reference_symbols = [\n    np.asarray(pmt.c32vector_elements(\n        pmt.cdr(reference_debug.get_message(i))),\
      \ dtype=np.complex64)\n    for i in range(reference_debug.num_messages())]\n\
      reference = split_candidates(\n    reference_hard, reference_symbols,\n    sink_tags(self.blocks_reference_decisions_sink),\
      \ 'GNU Radio')\n\n# In symbols mode, every NPU output symbol carries its normalized\
      \ 48-carrier\n# values in the csi tag attached to the same hard-decision vector.\n\
      npu_hard = np.asarray(\n    self.blocks_npu_decisions_sink.data(), dtype=np.int8).reshape(-1,\
      \ 48)\nnpu_tags = sink_tags(self.blocks_npu_decisions_sink)\nnpu_symbols = []\n\
      for index in range(len(npu_hard)):\n    value = npu_tags.get(index, {}).get('csi')\n\
      \    if value is None:\n        raise AssertionError(f'NPU output symbol {index}\
      \ has no csi tag')\n    values = np.asarray(pmt.c32vector_elements(value), dtype=np.complex64)\n\
      \    if values.size < 48:\n        raise AssertionError(\n            f'NPU\
      \ csi tag {index} has {values.size} values; expected at least 48')\n    npu_symbols.append(values[:48])\n\
      actual = split_candidates(npu_hard, npu_symbols, npu_tags, 'NPU')\n\n# Reproduce\
      \ the procedural oracle's candidate classifications. The reference\n# magnitude\
      \ check rejects false wifi_start detections before cross-engine checks.\nmatched_actual\
      \ = []\nmatched_reference = []\nmatched_evm = []\ngnu_only = 0\nnpu_only = 0\n\
      decision_disagreements = 0\nunusable = 0\nfor offset, reference_item, actual_item\
      \ in zip(\n        replay.candidate_offsets, reference, actual):\n    if (reference_item\
      \ is not None\n            and np.max(np.abs(reference_item[1])) > 3.0):\n \
      \       unusable += 1\n        continue\n    if reference_item is None:\n  \
      \      npu_only += actual_item is not None\n        continue\n    if actual_item\
      \ is None:\n        gnu_only += 1\n        continue\n    if not np.array_equal(reference_item[0],\
      \ actual_item[0]):\n        decision_disagreements += 1\n        continue\n\
      \    reference_symbol = reference_item[1]\n    actual_symbol = actual_item[1]\n\
      \    evm = float(np.sqrt(\n        np.mean(np.abs(actual_symbol - reference_symbol)\
      \ ** 2) /\n        np.mean(np.abs(reference_symbol) ** 2)))\n    gain = np.vdot(reference_symbol,\
      \ actual_symbol) / np.vdot(\n        reference_symbol, reference_symbol)\n \
      \   matched_reference.append(reference_symbol)\n    matched_actual.append(actual_symbol)\n\
      \    matched_evm.append(evm)\n    print(f'  offset={offset} evm={100*evm:.4f}%\
      \ '\n          f'gain={abs(gain):.5f} phase={np.angle(gain):.5f} '\n       \
      \   f'ref_max={np.max(np.abs(reference_symbol)):.3f} '\n          f'npu_max={np.max(np.abs(actual_symbol)):.3f}')\n\
      \n# Report per-candidate accounting first, then enforce one aggregate EVM limit\n\
      # across only mutually decoded candidates with matching hard decisions.\n\n\
      print(f'recorded candidates: samples={replay.sample_count} '\n      f'wifi_start={replay.wifi_start_count}\
      \ matched={len(matched_actual)} '\n      f'GNU_only={gnu_only} NPU_only={npu_only}\
      \ '\n      f'hard_disagreements={decision_disagreements} '\n      f'unusable_false_frames={unusable}')\n\
      if not matched_actual:\n    raise AssertionError('no mutually decoded recorded\
      \ frame candidates')\nprint(f'matched-frame EVM: median={100*np.median(matched_evm):.4f}%\
      \ '\n      f'min={100*np.min(matched_evm):.4f}% '\n      f'max={100*np.max(matched_evm):.4f}%')\n\
      actual_array = np.asarray(matched_actual)\nreference_array = np.asarray(matched_reference)\n\
      error = actual_array - reference_array\nevm = np.sqrt(np.mean(np.abs(error)\
      \ ** 2) /\n              np.mean(np.abs(reference_array) ** 2))\ngain = np.vdot(reference_array.ravel(),\
      \ actual_array.ravel()) / np.vdot(\n    reference_array.ravel(), reference_array.ravel())\n\
      print(f'recorded FFT matched candidates: rms_evm={100*evm:.5f}% '\n      f'max_abs={np.max(np.abs(error)):.7f}\
      \ gain={abs(gain):.8f} '\n      f'phase={np.angle(gain):.8g} rad')\nif not evm\
      \ < 5e-2:\n    raise AssertionError(\n        f'recorded FFT matched candidates:\
      \ EVM {evm} is not below 0.05')\nprint(f'frame_equalizer {self.algorithm} recorded\
      \ GRC comparison passed')"
    comment: Reconstruct candidate results at marker boundaries and apply the Python
      oracle's checks.
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [128, 816.0]
    rotation: 0
    state: enabled
