- name: build_guard
  id: snippet
  parameters:
    alias: ''
    code: "from pathlib import Path\n\nbuild = Path('build')\nmarker = build / 'frame_equalizer_build_mode.txt'\n\
      artifacts = [build / 'final.xclbin', build / 'insts.bin']\nmissing = [str(path)\
      \ for path in [marker, *artifacts] if not path.is_file()]\nif missing:\n   \
      \ raise RuntimeError(\n        'missing frame-equalizer build output(s): ' +\
      \ ', '.join(missing) +\n        '; run `make learned-ber ENGINE=CLASSIC` or\
      \ `ENGINE=AI`')\nself.build_mode = {}\nfor line in marker.read_text().splitlines():\n\
      \    if '=' in line:\n        key, value = line.split('=', 1)\n        self.build_mode[key.strip()]\
      \ = value.strip()\nif self.build_mode.get('DFRAME_EQUALIZER_OUTPUT_SYMBOLS')\
      \ != '0':\n    raise RuntimeError('BER benchmark requires a production-mode\
      \ build')\nif self.build_mode.get('EQUALIZER_ALGORITHM') not in {'LS', 'LMS', 'COMB', 'STA', 'CNN'}:\n    raise\
      \ RuntimeError('invalid or missing EQUALIZER_ALGORITHM in ' + str(marker))\nif self.build_mode.get('ENGINE')\
      \ not in {'CLASSIC', 'AI'}:\n    raise RuntimeError('invalid or missing ENGINE\
      \ in ' + str(marker))\nif marker.stat().st_mtime_ns < max(path.stat().st_mtime_ns\
      \ for path in artifacts):\n    raise RuntimeError(str(marker) + ' is older than\
      \ the NPU artifacts; rebuild')"
    comment: Reject stale or incompatible NPU images before block construction.
    priority: '0'
    section: init_before_blocks
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 120.0]
