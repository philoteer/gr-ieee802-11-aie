- name: report
  id: snippet
  parameters:
    alias: ''
    code: "# Rebuild per-tile results after the stream stops.\n#\n# The NPU adapter\
      \ compacts away empty tile outputs. Every transmitted frame\n# is followed by\
      \ a standards-generated zero-length delimiter frame; splitting\n# at those decisions\
      \ recovers one result segment per physical tile.\nimport json\nfrom pathlib\
      \ import Path\nimport numpy as np\nimport pmt\n\nhard = np.asarray(self.blocks_npu_decisions_sink.data(),\
      \ dtype=np.uint8).reshape(-1, 48)\ntruths = np.asarray(self.blocks_payload_truth_sink.data(),\
      \ dtype=np.uint8)\nif truths.size != 384 * self.frame_count:\n    raise AssertionError(\n\
      \        f'truth stream has {truths.size} labels; expected {384 * self.frame_count}')\n\
      truths = truths.reshape(self.frame_count, 8, 48)\nmarker_hard = np.asarray(self.marker_payload,\
      \ dtype=np.uint8)\n\n# Index adapter metadata by output-symbol offset.\ntags\
      \ = {}\nfor tag in self.blocks_npu_decisions_sink.tags():\n    offset = int(tag.offset)\n\
      \    key = pmt.symbol_to_string(tag.key)\n    tags.setdefault(offset, {})[key]\
      \ = tag.value\n\n# Split compacted output at each marker frame.\nsegments =\
      \ []\npending = []\nfor index, decisions in enumerate(hard):\n    frame_bytes\
      \ = tags.get(index, {}).get('frame bytes')\n    is_marker = (frame_bytes is\
      \ not None and\n                 pmt.to_uint64(frame_bytes) == 0 and\n     \
      \            np.array_equal(decisions, marker_hard))\n    if is_marker:\n  \
      \      segments.append(pending)\n        pending = []\n    else:\n        pending.append(index)\n\
      if pending:\n    raise AssertionError('NPU output ended without a marker delimiter')\n\
      if len(segments) != self.frame_count:\n    raise AssertionError(\n        f'marker\
      \ count {len(segments)} != transmitted frame count {self.frame_count}')\n\n\
      # Accumulators hold received errors/counts followed by transmitted counts.\n\
      # Invalid RATE, LENGTH, or output length is reported as a packet miss. The\n\
      # combined rates additionally count every bit and symbol in that packet wrong.\n\
      bit_widths = {'bpsk': 1, 'qpsk': 2, 'qam16': 4, 'qam64': 6}\ntotals = {name:\
      \ np.zeros(6, np.int64) for name in bit_widths}\ndropped = {name: 0 for name\
      \ in bit_widths}\nframes = {name: 0 for name in bit_widths}\nfor frame_index,\
      \ (segment, truth) in enumerate(zip(segments, truths)):\n    name, rate, modulation,\
      \ length, encoding = self.configurations[frame_index % 4]\n    frame_tags =\
      \ [tags[index] for index in segment\n                  if 'frame bytes' in tags.get(index,\
      \ {})]\n    tag_valid = len(frame_tags) == 1\n    if tag_valid:\n        tag\
      \ = frame_tags[0]\n        tag_valid = ('encoding' in tag and\n            \
      \         (pmt.to_uint64(tag['frame bytes']),\n                      pmt.to_uint64(tag['encoding']))\
      \ == (length, encoding))\n    frame_valid = tag_valid and len(segment) == 8\n\
      \    bits_per_symbol = bit_widths[name]\n    expected = truth.reshape(-1)\n\
      \    total_bits = expected.size * bits_per_symbol\n    if frame_valid:\n   \
      \     actual = hard[segment].reshape(-1)\n        xor = actual ^ expected\n\
      \        bit_errors = sum(int(np.count_nonzero((xor >> bit) & 1))\n        \
      \                 for bit in range(bits_per_symbol))\n        symbol_errors\
      \ = int(np.count_nonzero(actual != expected))\n        received_bits = total_bits\n\
      \        received_symbols = expected.size\n    else:\n        bit_errors = 0\n\
      \        symbol_errors = 0\n        received_bits = 0\n        received_symbols\
      \ = 0\n    totals[name] += (bit_errors, symbol_errors, received_bits,\n    \
      \                 received_symbols, total_bits, expected.size)\n    dropped[name]\
      \ += int(not frame_valid)\n    frames[name] += 1\n\nreport = {\n    'engine':\
      \ self.build_mode.get('ENGINE'),\n    'algorithm': self.build_mode.get('EQUALIZER_ALGORITHM'),\n    'seed': self.seed,\n    'batches': self.batches,\n\
      \    'constellation_source': 'installed ieee802_11 Python bindings',\n    'models':\
      \ {},\n}\nfor name, values in totals.items():\n    (bit_errors, symbol_errors,\
      \ received_bits, received_symbols,\n     bits, symbols) = map(int, values)\n\
      \    missed_packets = dropped[name]\n    combined_bit_errors = bit_errors +\
      \ bits - received_bits\n    combined_symbol_errors = symbol_errors + symbols\
      \ - received_symbols\n    report['models'][name] = {\n        'ber_received':\
      \ bit_errors / received_bits if received_bits else None,\n        'ber_combined':\
      \ combined_bit_errors / bits,\n        'packet_miss_rate': missed_packets /\
      \ frames[name],\n        'ser_received': symbol_errors / received_symbols if\
      \ received_symbols else None,\n        'ser_combined': combined_symbol_errors\
      \ / symbols,\n        'received_bit_errors': bit_errors,\n        'received_bits':\
      \ received_bits,\n        'combined_bit_errors': combined_bit_errors,\n    \
      \    'total_bits': bits,\n        'missed_packets': missed_packets,\n      \
      \  'packets': frames[name],\n    }\nrendered = json.dumps(report, indent=2)\n\
      print(rendered)\nif self.output_file:\n    Path(self.output_file).write_text(rendered\
      \ + '\\n')"
    comment: Reconstruct tile results at marker boundaries and emit the BER JSON report.
    priority: '0'
    section: main_after_stop
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1408, 232.0]
